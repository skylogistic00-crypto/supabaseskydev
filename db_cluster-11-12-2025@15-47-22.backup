--

CREATE FUNCTION public.repost_gl_for_journal_entry(p_je_id text) RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
  PERFORM public.repost_gl_for_journal_entry(p_je_id::uuid);
END;
$$;


ALTER FUNCTION public.repost_gl_for_journal_entry(p_je_id text) OWNER TO postgres;

--
-- Name: repost_gl_for_journal_entry(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.repost_gl_for_journal_entry(p_je_id uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- bersihkan GL untuk JE ini
  DELETE FROM public.general_ledger gl
   WHERE gl.journal_entry_id = p_je_id;

  -- isi ulang; account_code = JE.account_number (kebijakan Anda)
  INSERT INTO public.general_ledger (
    id, journal_entry_id,
    "date", posting_date,             -- <<— isi keduanya
    account_code, description,
    debit, credit, amount_signed
  )
  SELECT
    gen_random_uuid(),
    je.id,
    COALESCE(je."date", CURRENT_DATE),         -- aman dari NULL
    COALESCE(je."date", CURRENT_DATE),         -- aman dari NULL
    je.account_number,                         -- = header JE
    COALESCE(jei.description, je.description),
    COALESCE(jei.debit,0)::numeric,
    COALESCE(jei.credit,0)::numeric,
    (COALESCE(jei.debit,0) - COALESCE(jei.credit,0))::numeric
  FROM public.journal_entries je
  JOIN public.journal_entry_items jei
    ON jei.journal_entry_id = je.id
  WHERE je.id = p_je_id;
END;
$$;


ALTER FUNCTION public.repost_gl_for_journal_entry(p_je_id uuid) OWNER TO postgres;

--
-- Name: reset_transaction_tax(uuid, uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.reset_transaction_tax(p_id uuid, p_user uuid DEFAULT NULL::uuid) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
declare x jsonb;
begin
  update bank_statements
  set is_taxable=true,
      tax_status='auto',
      updated_at=now()
  where id=p_id;

  x := apply_tax_engine(p_id);
  return x;
end;
$$;


ALTER FUNCTION public.reset_transaction_tax(p_id uuid, p_user uuid) OWNER TO postgres;

