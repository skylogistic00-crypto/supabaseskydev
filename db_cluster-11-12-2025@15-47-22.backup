--
-- Name: get_profit_and_loss(date, date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_profit_and_loss(p_start_date date, p_end_date date) RETURNS TABLE(section text, account_code text, account_name text, amount numeric)
    LANGUAGE sql
    AS $$
    WITH pl AS (
        SELECT 
            jel.account_code,
            MIN(jel.account_name) AS account_name,
            SUM(jel.credit - jel.debit) AS amount
        FROM public.journal_entry_lines jel
        JOIN public.journal_entries je ON jel.journal_id = je.id
        WHERE je.journal_date BETWEEN p_start_date AND p_end_date
        GROUP BY jel.account_code
    )
    SELECT 
        CASE 
            WHEN account_code LIKE '4%' THEN 'Pendapatan'
            WHEN account_code LIKE '5%' THEN 'Harga Pokok Penjualan'
            WHEN account_code LIKE '6%' THEN 'Beban Usaha'
            WHEN account_code LIKE '7%' THEN 'Beban Lain'
            WHEN account_code LIKE '8%' THEN 'Pendapatan Lain'
            ELSE 'Lainnya'
        END AS section,
        account_code,
        account_name,
        amount
    FROM pl
    WHERE account_code LIKE ANY (ARRAY['4%', '5%', '6%', '7%', '8%'])
    ORDER BY section, account_code;
$$;


ALTER FUNCTION public.get_profit_and_loss(p_start_date date, p_end_date date) OWNER TO postgres;

