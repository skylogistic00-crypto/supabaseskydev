--
-- Name: generate_neraca(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_neraca() RETURNS TABLE(type text, amount numeric)
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY SELECT 'Aset', SUM(debit - credit)
    FROM journal_entry_lines
    WHERE account_code LIKE '1%';

    RETURN QUERY SELECT 'Liabilitas', SUM(credit - debit)
    FROM journal_entry_lines
    WHERE account_code LIKE '2%';

    RETURN QUERY SELECT 'Ekuitas', SUM(credit - debit)
    FROM journal_entry_lines
    WHERE account_code LIKE '3%';
END;
$$;


