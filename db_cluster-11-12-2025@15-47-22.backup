--
-- Name: update_stock_total_value(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_stock_total_value() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  NEW.total_value := COALESCE(NEW.quantity, 0) * COALESCE(NEW.average_cost, 0);
  RETURN NEW;
END;
$$;


