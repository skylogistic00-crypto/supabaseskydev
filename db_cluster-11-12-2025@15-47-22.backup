--
-- Name: generate_consignee_code(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_consignee_code() RETURNS trigger
    LANGUAGE plpgsql
    AS $_$
DECLARE
  next_number INTEGER;
  new_code TEXT;
BEGIN
  SELECT COALESCE(MAX(CAST(SUBSTRING(consignee_code FROM 4) AS INTEGER)), 0) + 1
  INTO next_number
  FROM consignees
  WHERE consignee_code ~ '^CNS[0-9]+$';
  
  new_code := 'CNS' || LPAD(next_number::TEXT, 4, '0');
  
  NEW.consignee_code := new_code;
  
  RETURN NEW;
END;
$_$;


