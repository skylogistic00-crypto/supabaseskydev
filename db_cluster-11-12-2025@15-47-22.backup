--
-- Name: balance_sheet(date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.balance_sheet(report_date date) RETURNS TABLE(account_code text, account_name text, amount numeric)
    LANGUAGE sql STABLE
    AS $$
WITH balances AS (
    SELECT 
        coa.account_code,
        coa.account_name,
        coa.account_type,
        SUM(gl.debit - gl.credit) AS balance
    FROM general_ledger gl
    JOIN journal_entries je ON je.id = gl.journal_id
    JOIN chart_of_accounts coa ON coa.account_code = gl.account_code
    WHERE je.transaction_date <= report_date
    GROUP BY coa.account_code, coa.account_name, coa.account_type
)
SELECT 
    account_code,
    account_name,
    CASE 
        WHEN account_type = 'Aset' THEN balance
        WHEN account_type IN ('Kewajiban','Ekuitas') THEN -balance
    END AS amount
FROM balances
WHERE account_type IN ('Aset','Kewajiban','Ekuitas')
ORDER BY account_code;
$$;


ALTER FUNCTION public.balance_sheet(report_date date) OWNER TO postgres;

--
-- Name: calculate_late_fee(date, date, numeric); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calculate_late_fee(p_due_date date, p_payment_date date, p_installment_amount numeric) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_days_late INTEGER;
  v_late_fee DECIMAL;
BEGIN
  IF p_payment_date IS NULL OR p_payment_date <= p_due_date THEN
    RETURN 0;
  END IF;
  
  v_days_late := p_payment_date - p_due_date;
  v_late_fee := p_installment_amount * 0.001 * v_days_late;
  
  RETURN v_late_fee;
END;
$$;


ALTER FUNCTION public.calculate_late_fee(p_due_date date, p_payment_date date, p_installment_amount numeric) OWNER TO postgres;

--
-- Name: calculate_late_fee(date, date, numeric, numeric); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calculate_late_fee(p_due_date date, p_payment_date date, p_installment_amount numeric, p_late_fee_percentage numeric DEFAULT 0.1) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_days_late INTEGER;
  v_late_fee DECIMAL;
BEGIN
  IF p_payment_date IS NULL OR p_payment_date <= p_due_date THEN
    RETURN 0;
  END IF;
  
  v_days_late := p_payment_date - p_due_date;
  v_late_fee := p_installment_amount * (p_late_fee_percentage / 100) * v_days_late;
  
  RETURN v_late_fee;
END;
$$;


ALTER FUNCTION public.calculate_late_fee(p_due_date date, p_payment_date date, p_installment_amount numeric, p_late_fee_percentage numeric) OWNER TO postgres;

--
-- Name: calculate_stock_value(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calculate_stock_value(p_sku text) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_qty NUMERIC;
  v_avg_cost NUMERIC;
BEGIN
  SELECT quantity, average_cost INTO v_qty, v_avg_cost
  FROM stock
  WHERE sku = p_sku;
  
  RETURN COALESCE(v_qty, 0) * COALESCE(v_avg_cost, 0);
END;
$$;


ALTER FUNCTION public.calculate_stock_value(p_sku text) OWNER TO postgres;

--
-- Name: calculate_tax(numeric, numeric); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calculate_tax(p_base_amount numeric, p_tax_percentage numeric) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF p_tax_percentage IS NULL OR p_tax_percentage = 0 THEN
    RETURN 0;
  END IF;
  
  RETURN p_base_amount * (p_tax_percentage / 100);
END;
$$;


ALTER FUNCTION public.calculate_tax(p_base_amount numeric, p_tax_percentage numeric) OWNER TO postgres;

--
-- Name: calculate_work_hours(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calculate_work_hours() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF NEW.clock_in IS NOT NULL AND NEW.clock_out IS NOT NULL THEN
    NEW.work_hours := EXTRACT(EPOCH FROM (NEW.clock_out - NEW.clock_in)) / 3600;
    
    -- Calculate overtime (if work_hours > 8)
    IF NEW.work_hours > 8 THEN
      NEW.overtime_hours := NEW.work_hours - 8;
    END IF;
  END IF;
  RETURN NEW;
END;
$$;


