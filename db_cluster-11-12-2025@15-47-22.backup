--
-- Name: get_journal_entries_with_coa(date, date, uuid, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_journal_entries_with_coa(p_start_date date DEFAULT NULL::date, p_end_date date DEFAULT NULL::date, p_account_id uuid DEFAULT NULL::uuid, p_account_code text DEFAULT NULL::text) RETURNS TABLE(id uuid, journal_entry_id uuid, account_id uuid, account_code text, account_name text, account_type text, normal_balance text, date date, description text, debit numeric, credit numeric, created_at timestamp with time zone)
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  RETURN QUERY
  SELECT 
    gl.id,
    gl.journal_entry_id,
    COALESCE(gl.account_id, coa.id) as account_id,
    COALESCE(gl.account_code, coa.account_code) as account_code,
    COALESCE(gl.account_name, coa.account_name) as account_name,
    coa.account_type,
    coa.normal_balance,
    gl.date,
    gl.description,
    gl.debit,
    gl.credit,
    gl.created_at
  FROM general_ledger gl
  LEFT JOIN chart_of_accounts coa ON gl.account_id = coa.id OR gl.account_code = coa.account_code
  WHERE (p_start_date IS NULL OR gl.date >= p_start_date)
    AND (p_end_date IS NULL OR gl.date <= p_end_date)
    AND (p_account_id IS NULL OR gl.account_id = p_account_id OR coa.id = p_account_id)
    AND (p_account_code IS NULL OR gl.account_code = p_account_code OR coa.account_code = p_account_code)
  ORDER BY gl.date, gl.created_at;
END;
$$;


ALTER FUNCTION public.get_journal_entries_with_coa(p_start_date date, p_end_date date, p_account_id uuid, p_account_code text) OWNER TO postgres;

--
-- Name: get_next_transaction_number(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_next_transaction_number(p_prefix text) RETURNS text
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_year TEXT;
  v_count INTEGER;
  v_number TEXT;
BEGIN
  v_year := TO_CHAR(CURRENT_DATE, 'YYYY');
  
  SELECT COUNT(*) + 1 INTO v_count
  FROM transactions
  WHERE transaction_number LIKE p_prefix || '-' || v_year || '-%';
  
  v_number := p_prefix || '-' || v_year || '-' || LPAD(v_count::TEXT, 5, '0');
  
  RETURN v_number;
END;
$$;


ALTER FUNCTION public.get_next_transaction_number(p_prefix text) OWNER TO postgres;

--
-- Name: get_or_create_employee_advance_coa(uuid, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_or_create_employee_advance_coa(p_employee_id uuid, p_employee_name text) RETURNS text
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_account_code TEXT;
  v_next_number INTEGER;
BEGIN
  -- Check if employee already has an advance account
  SELECT coa_account_code INTO v_account_code
  FROM employee_advances
  WHERE employee_id = p_employee_id
  LIMIT 1;
  
  -- If found, return existing account code
  IF v_account_code IS NOT NULL THEN
    RETURN v_account_code;
  END IF;
  
  -- Generate new account code
  -- Find the next available number under 1-1009 (Uang Muka Karyawan)
  SELECT COALESCE(MAX(CAST(SUBSTRING(account_code FROM 8) AS INTEGER)), 0) + 1
  INTO v_next_number
  FROM chart_of_accounts
  WHERE account_code LIKE '1-1009-%';
  
  -- Create account code (e.g., 1-1009-001, 1-1009-002, etc.)
  v_account_code := '1-1009-' || LPAD(v_next_number::TEXT, 3, '0');
  
  -- Insert new COA account for this employee
  INSERT INTO chart_of_accounts (
    account_code,
    account_name,
    account_type,
    level,
    is_header,
    normal_balance,
    description,
    parent_code
  ) VALUES (
    v_account_code,
    'Uang Muka Karyawan - ' || p_employee_name,
    'Aset',
    3,
    false,
    'Debit',
    'Uang muka yang diberikan kepada ' || p_employee_name,
    '1-1009'
  )
  ON CONFLICT (account_code) DO NOTHING;
  
  RETURN v_account_code;
END;
$$;


ALTER FUNCTION public.get_or_create_employee_advance_coa(p_employee_id uuid, p_employee_name text) OWNER TO postgres;

--
-- Name: FUNCTION get_or_create_employee_advance_coa(p_employee_id uuid, p_employee_name text); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.get_or_create_employee_advance_coa(p_employee_id uuid, p_employee_name text) IS 'Automatically creates or retrieves COA account code for employee advance (e.g., 1-1009-001 for first employee)';


