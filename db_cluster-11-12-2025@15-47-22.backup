-- Name: notify_user_activated(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.notify_user_activated() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
begin
  -- KALAU status berubah dari "inactive" -> "active"
  if OLD.status <> 'active' and NEW.status = 'active' then
    perform net.http_post(
      url := 'https://gfmokpjnnnbnjlqxhoux.supabase.co/functions/v1/send-activation-email',
      headers := jsonb_build_object(
        'Content-Type', 'application/json'
      ),
      body := jsonb_build_object(
        'email', NEW.email,
        'full_name', NEW.full_name
      )
    );
  end if;

  return NEW;
end;
$$;


