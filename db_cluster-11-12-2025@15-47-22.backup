--
-- Name: embedding_coa_match(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.embedding_coa_match(p_text text) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
declare
  result jsonb;
  response text;
begin
  select (net.http_post(
    'https://<YOUR-EDGE-FUNCTION-URL>/coa-auto-match',
    jsonb_build_object('text', p_text)::text,
    jsonb_build_object('timeout', 8000)::text
  )).content into response;

  result := response::jsonb;
  return result;
end;
$$;


ALTER FUNCTION public.embedding_coa_match(p_text text) OWNER TO postgres;

--
-- Name: execute_sql(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.execute_sql(query text) RETURNS jsonb
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  result JSONB;
BEGIN
  -- Execute the query and return results as JSONB
  EXECUTE format('SELECT jsonb_agg(row_to_json(t)) FROM (%s) t', query) INTO result;
  
  -- Return empty array if no results
  IF result IS NULL THEN
    result := '[]'::jsonb;
  END IF;
  
  RETURN result;
EXCEPTION
  WHEN OTHERS THEN
    RAISE EXCEPTION 'SQL execution error: %', SQLERRM;
END;
$$;


ALTER FUNCTION public.execute_sql(query text) OWNER TO postgres;

--
-- Name: FUNCTION execute_sql(query text); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.execute_sql(query text) IS 'Execute dynamic SQL queries for AI-generated queries. Returns results as JSONB array.';


--
-- Name: extract_keywords(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.extract_keywords(p_text text) RETURNS text[]
    LANGUAGE plpgsql
    AS $$
declare
  cleaned text;
begin
  cleaned := lower(regexp_replace(p_text, '[^a-z0-9 ]', ' ', 'g'));
  cleaned := regexp_replace(cleaned, '\s+', ' ', 'g');
  return string_to_array(trim(cleaned), ' ');
end;
$$;


ALTER FUNCTION public.extract_keywords(p_text text) OWNER TO postgres;

