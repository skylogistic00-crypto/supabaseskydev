--
-- Name: cancel_journal(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.cancel_journal(p_journal_id uuid) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_old journal_entries%ROWTYPE;
    v_new_journal_id UUID;
BEGIN
    SELECT * INTO v_old FROM public.journal_entries WHERE id = p_journal_id;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Journal % not found', p_journal_id;
    END IF;

    UPDATE public.journal_entries SET status = 'void' WHERE id = p_journal_id;

    INSERT INTO public.journal_entries (journal_number, journal_date, reference_id, reference_type, description, currency_code, exchange_rate, status, created_at)
    VALUES (CONCAT(COALESCE(v_old.journal_number, substring(v_old.id::text,1,8)), '-R'), v_old.journal_date, v_old.reference_id, v_old.reference_type, CONCAT(v_old.description, ' (Reversal)'), v_old.currency_code, v_old.exchange_rate, 'posted', NOW())
    RETURNING id INTO v_new_journal_id;

    INSERT INTO public.journal_entry_lines (journal_id, account_code, account_name, debit, credit, description, created_at)
    SELECT v_new_journal_id, account_code, account_name, credit, debit, CONCAT(description, ' (Reversal)'), NOW()
    FROM public.journal_entry_lines
    WHERE journal_id = p_journal_id;

    -- if linked to cash_disbursement, reset it
    UPDATE public.cash_disbursement SET status = 'approved', journal_id = NULL WHERE journal_id = p_journal_id;

    RETURN v_new_journal_id;
END;
$$;


ALTER FUNCTION public.cancel_journal(p_journal_id uuid) OWNER TO postgres;

--
-- Name: cash_flow_statement(date, date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.cash_flow_statement(start_date date, end_date date) RETURNS TABLE(section text, account_code text, account_name text, amount numeric)
    LANGUAGE sql STABLE
    AS $$
WITH data AS (
    SELECT
        coa.account_code,
        coa.account_name,
        coa.account_type,
        SUM(gl.debit - gl.credit) AS net_change
    FROM general_ledger gl
    JOIN journal_entries je ON gl.journal_id = je.id
    JOIN chart_of_accounts coa ON coa.account_code = gl.account_code
    WHERE je.transaction_date BETWEEN start_date AND end_date
    GROUP BY coa.account_code, coa.account_name, coa.account_type
)
SELECT 
    CASE 
        WHEN account_type IN ('Pendapatan','Beban','HPP') THEN 'OPERATING'
        WHEN account_type IN ('Aset') THEN 'INVESTING'
        WHEN account_type IN ('Ekuitas','Kewajiban') THEN 'FINANCING'
    END AS section,
    account_code,
    account_name,
    net_change AS amount
FROM data
ORDER BY section, account_code;
$$;


ALTER FUNCTION public.cash_flow_statement(start_date date, end_date date) OWNER TO postgres;

--
-- Name: check_availability(uuid, timestamp with time zone, timestamp with time zone); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.check_availability(f_id uuid, s timestamp with time zone, e timestamp with time zone) RETURNS boolean
    LANGUAGE sql STABLE
    AS $$
  select not exists(
    select 1 from bookings b
    where b.facility_id = f_id
      and b.status != 'cancelled'
      and tstzrange(b.start_time, b.end_time, '[)') && tstzrange(s, e, '[)')
  );
$$;


