--

CREATE FUNCTION public.reverse_journal(journal_id uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
    INSERT INTO journal_entry_lines (journal_id, account_code, debit, credit)
    SELECT journal_id, account_code, credit, debit
    FROM journal_entry_lines
    WHERE journal_id = reverse_journal.journal_id;
END;
$$;


