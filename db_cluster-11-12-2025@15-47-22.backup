--
-- Name: post_journal_to_general_ledger(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.post_journal_to_general_ledger(p_journal_id uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_journal journal_entries%ROWTYPE;
BEGIN
  -- Ambil header journal
  SELECT *
  INTO v_journal
  FROM journal_entries
  WHERE id = p_journal_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Journal entry % not found', p_journal_id;
  END IF;

  -- Insert semua baris dari journal_entry_items ke general_ledger
  INSERT INTO general_ledger (
    id,
    journal_entry_id,
    account_code,
    debit,
    credit,
    posting_date,
    description
  )
  SELECT
    gen_random_uuid() AS id,
    jei.journal_entry_id,
    jei.account_code,
    jei.debit,
    jei.credit,
    v_journal.journal_date AS posting_date,
    v_journal.description
  FROM journal_entry_items jei
  WHERE jei.journal_entry_id = p_journal_id;
END;
$$;


ALTER FUNCTION public.post_journal_to_general_ledger(p_journal_id uuid) OWNER TO postgres;

--
-- Name: post_to_general_ledger(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.post_to_general_ledger() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_journal journal_entries%ROWTYPE;
BEGIN
  -- Ambil header journal untuk ambil tanggal & deskripsi
  SELECT *
  INTO v_journal
  FROM journal_entries
  WHERE id = NEW.journal_entry_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Journal entry % not found', NEW.journal_entry_id;
  END IF;

  -- Insert ke general_ledger
  INSERT INTO general_ledger (
    id,
    journal_entry_id,
    account_code,
    debit,
    credit,
    posting_date,
    description
  )
  VALUES (
    gen_random_uuid(),
    NEW.journal_entry_id,
    NEW.account_code,
    NEW.debit,
    NEW.credit,
    v_journal.journal_date,
    v_journal.description
  );

  RETURN NEW;
END;
$$;


