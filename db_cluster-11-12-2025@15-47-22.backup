-- Data for Name: ijazah_results; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY public.ijazah_results (id, user_id, nomor_ijazah, nama, tempat_lahir, tanggal_lahir, nama_sekolah, jenjang, jurusan, tahun_lulus, tanggal_lulus, nomor_peserta_ujian, raw_text, processed_at, created_at) FROM stdin;
\.


--
-- Data for Name: internal_usage; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY public.internal_usage (id, usage_date, item_id, item_name, stock_before, quantity, stock_after, unit_cost, total_cost, department_id, department_name, usage_location, coa_account_code, coa_account_name, purpose, verified_by, verified_by_name, notes, created_by, created_at, updated_at, coa_expense_code, coa_inventory_code) FROM stdin;
\.


