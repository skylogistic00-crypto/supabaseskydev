--
-- Name: post_bank_statement_as_journal(uuid, uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.post_bank_statement_as_journal(p_id uuid, p_user uuid DEFAULT NULL::uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$
declare
  bs record;
  tax jsonb;
  trx uuid := gen_random_uuid();
  amount numeric;
begin
  select * into bs from bank_statements where id = p_id;

  if bs.status = 'posted' then
    raise exception 'Transaksi % sudah diposting', p_id;
  end if;

  perform apply_tax_engine(p_id);
  select tax_result into tax from bank_statements where id = p_id;

  amount := greatest(bs.debit, bs.credit);

  perform validate_coa(bs.mapped_coa_debit);
  perform validate_coa(bs.mapped_coa_credit);

  if tax->>'pajak' <> 'none' then
    perform validate_coa((tax->>'akun_dasar'));
    perform validate_coa((tax->>'akun_pajak'));
  end if;

  insert into transactions(id, transaction_date, description, total_amount, created_by)
  values (trx, bs.transaction_date, bs.description, amount, p_user);

  if tax->>'pajak' = 'none' then

    insert into journal_entries(id, transaction_id, account_code, debit, description)
    values (gen_random_uuid(), trx, bs.mapped_coa_debit, amount, bs.description);

    insert into journal_entries(id, transaction_id, account_code, credit, description)
    values (gen_random_uuid(), trx, bs.mapped_coa_credit, amount, bs.description);

  else

    insert into journal_entries(id, transaction_id, account_code, debit, description)
    values (gen_random_uuid(), trx, tax->>'akun_dasar', (tax->>'base_amount')::numeric, bs.description);

    insert into journal_entries(id, transaction_id, account_code, debit, description)
    values (gen_random_uuid(), trx, tax->>'akun_pajak', (tax->>'tax_amount')::numeric, bs.description);

    insert into journal_entries(id, transaction_id, account_code, credit, description)
    values (gen_random_uuid(), trx, bs.mapped_coa_credit, amount, bs.description);

  end if;

  update bank_statements set status='posted', updated_at=now() where id = p_id;
end;
$$;


ALTER FUNCTION public.post_bank_statement_as_journal(p_id uuid, p_user uuid) OWNER TO postgres;

--
-- Name: post_cash_disbursement(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.post_cash_disbursement(disbursement_id uuid) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
DECLARE
    disb RECORD;
    map RECORD;
    jid UUID;
BEGIN
    SELECT * INTO disb FROM cash_disbursement WHERE id = disbursement_id;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Cash Disbursement not found';
    END IF;

    SELECT * INTO map FROM account_mappings WHERE category = disb.category;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'Account mapping not found for category %', disb.category;
    END IF;

    INSERT INTO journal_entries (journal_number, description, reference_id)
    VALUES (generate_journal_number(), disb.description, disbursement_id)
    RETURNING id INTO jid;

    INSERT INTO journal_entry_lines (journal_id, account_code, debit, credit)
    VALUES (jid, map.debit_account, disb.amount, 0);

    INSERT INTO journal_entry_lines (journal_id, account_code, debit, credit)
    VALUES (jid, map.credit_account, 0, disb.amount);

    UPDATE cash_disbursement
    SET journal_id = jid, status = 'posted'
    WHERE id = disbursement_id;

    RETURN jid;
END;
$$;


ALTER FUNCTION public.post_cash_disbursement(disbursement_id uuid) OWNER TO postgres;

--
-- Name: post_cash_disbursement_to_journal(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.post_cash_disbursement_to_journal(p_disbursement_id uuid) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_journal_id UUID;
    v_journal_number TEXT;
    v_date DATE;
    v_description TEXT;
    v_account_code TEXT;
    v_account_name TEXT;
    v_amount NUMERIC(18,2);
    v_tax_amount NUMERIC(18,2);
    v_total NUMERIC(18,2);
    v_cash_account_id UUID;
    v_bank_account_id UUID;
    v_currency_code TEXT;
    v_exchange_rate NUMERIC(18,6);
    v_cash_account_code TEXT;
    v_cash_account_name TEXT;
BEGIN
    SELECT 
        transaction_date,
        COALESCE(notes, '') AS description,
        account_code,
        account_name,
        COALESCE(amount,0),
        COALESCE(tax_amount,0),
        COALESCE(amount,0) + COALESCE(tax_amount,0),
        cash_account_id,
        bank_account_id,
        COALESCE(currency_code,'IDR'),
        COALESCE(exchange_rate,1)
    INTO
        v_date,
        v_description,
        v_account_code,
        v_account_name,
        v_amount,
        v_tax_amount,
        v_total,
        v_cash_account_id,
        v_bank_account_id,
        v_currency_code,
        v_exchange_rate
    FROM public.cash_disbursement
    WHERE id = p_disbursement_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Disbursement % not found', p_disbursement_id;
    END IF;

    -- prevent double posting
    PERFORM journal_id FROM public.cash_disbursement WHERE id = p_disbursement_id AND journal_id IS NOT NULL;
    IF FOUND THEN
        RAISE EXCEPTION 'Disbursement % already posted', p_disbursement_id;
    END IF;

    -- get cash/bank account code
    IF v_cash_account_id IS NOT NULL THEN
        SELECT account_code, account_name INTO v_cash_account_code, v_cash_account_name
        FROM public.cash_accounts WHERE id = v_cash_account_id;
    ELSIF v_bank_account_id IS NOT NULL THEN
        SELECT account_code, account_name INTO v_cash_account_code, v_cash_account_name
        FROM public.bank_accounts WHERE id = v_bank_account_id;
    END IF;

    IF v_cash_account_code IS NULL THEN
        RAISE EXCEPTION 'Cash/Bank account mapping not found for disbursement %', p_disbursement_id;
    END IF;

    v_journal_number := CONCAT('JRN-', TO_CHAR(NOW(),'YYYYMMDD-HH24MISS'), '-', SUBSTRING(p_disbursement_id::text,1,6));

    INSERT INTO public.journal_entries (
        journal_number, journal_date, reference_id, reference_type, description, currency_code, exchange_rate, status, created_at
    ) VALUES (
        v_journal_number, v_date, p_disbursement_id, 'cash_disbursement', v_description, v_currency_code, v_exchange_rate, 'posted', NOW()
    ) RETURNING id INTO v_journal_id;

    -- debit: expense (includes tax)
    INSERT INTO public.journal_entry_lines (journal_id, account_code, account_name, debit, credit, description, created_at)
    VALUES (v_journal_id, v_account_code, v_account_name, v_total, 0, v_description, NOW());

    -- credit: cash/bank
    INSERT INTO public.journal_entry_lines (journal_id, account_code, account_name, debit, credit, description, created_at)
    VALUES (v_journal_id, v_cash_account_code, v_cash_account_name, 0, v_total, 'Cash/Bank Out', NOW());

    -- update disbursement
    UPDATE public.cash_disbursement SET journal_id = v_journal_id, status = 'posted' WHERE id = p_disbursement_id;

    RETURN v_journal_id;
END;
$$;


ALTER FUNCTION public.post_cash_disbursement_to_journal(p_disbursement_id uuid) OWNER TO postgres;

--
-- Name: post_journal_cash_disbursement(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.post_journal_cash_disbursement(p_id uuid) RETURNS json
    LANGUAGE plpgsql
    AS $$
DECLARE
    rec RECORD;
BEGIN
    SELECT 
        cd.*, 
        coa_cash.account_code AS cash_account_code,
        coa_exp.account_code AS expense_account_code
    INTO rec
    FROM cash_disbursement cd
    LEFT JOIN chart_of_accounts coa_cash ON coa_cash.id = cd.coa_cash_id
    LEFT JOIN chart_of_accounts coa_exp ON coa_exp.id = cd.coa_expense_id
    WHERE cd.id = p_id;

    IF rec.id IS NULL THEN
        RETURN json_build_object('success', false, 'error', 'Data tidak ditemukan');
    END IF;

    -- proses jurnal...
    RETURN json_build_object('success', true);
END;
$$;


ALTER FUNCTION public.post_journal_cash_disbursement(p_id uuid) OWNER TO postgres;

