--
-- Name: ai_allowed_tables Allow admins to manage ai_allowed_tables; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow admins to manage ai_allowed_tables" ON public.ai_allowed_tables TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.users
  WHERE ((users.id = auth.uid()) AND (users.role = 'admin'::text)))));


