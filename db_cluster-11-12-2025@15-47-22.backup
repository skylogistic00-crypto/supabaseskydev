--

CREATE FUNCTION public.set_supplier_name() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF NEW.supplier_id IS NOT NULL THEN
    SELECT s.supplier_name
      INTO NEW.supplier_name
    FROM public.suppliers s
    WHERE s.id = NEW.supplier_id;

    -- Optional: if not found, raise a clear error
    IF NEW.supplier_name IS NULL THEN
      RAISE EXCEPTION 'Supplier not found for id %', NEW.supplier_id
        USING ERRCODE = '23503';
    END IF;
  END IF;

  RETURN NEW;
END;
$$;


