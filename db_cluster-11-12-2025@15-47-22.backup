--
-- Name: create_gl_from_journal(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_gl_from_journal() RETURNS trigger
    LANGUAGE plpgsql
    AS $_$
DECLARE
  _gl_date   timestamp;
  _acct_code text;
  _desc      text;
  _has_desc  boolean;
  _sql       text;
BEGIN
  -- posting_date diset sama dengan date (fallback ke now() jika date null)
  _gl_date := COALESCE(NEW.date, now());

  -- ambil account code: prioritas account_number lalu account_code
  IF COALESCE(NEW.account_number, '') <> '' THEN
    _acct_code := NEW.account_number::text;
  ELSIF COALESCE(NEW.account_code, '') <> '' THEN
    _acct_code := NEW.account_code::text;
  ELSE
    _acct_code := NULL;
  END IF;

  -- ambil description dari beberapa kemungkinan kolom di journal_entries
  _desc := NULL;
  IF TG_OP = 'INSERT' THEN
    IF EXISTS (SELECT 1 FROM pg_catalog.pg_attribute
               WHERE attrelid = 'public.journal_entries'::regclass
                 AND attname = 'description') THEN
      _desc := NEW.description::text;
    ELSIF EXISTS (SELECT 1 FROM pg_catalog.pg_attribute
                  WHERE attrelid = 'public.journal_entries'::regclass
                    AND attname = 'note') THEN
      _desc := NEW.note::text;
    ELSIF EXISTS (SELECT 1 FROM pg_catalog.pg_attribute
                  WHERE attrelid = 'public.journal_entries'::regclass
                    AND attname = 'memo') THEN
      _desc := NEW.memo::text;
    ELSIF EXISTS (SELECT 1 FROM pg_catalog.pg_attribute
                  WHERE attrelid = 'public.journal_entries'::regclass
                    AND attname = 'remarks') THEN
      _desc := NEW.remarks::text;
    END IF;
  END IF;

  -- jika tidak ada account code, skip insert (hindari error NOT NULL)
  IF _acct_code IS NULL THEN
    RAISE NOTICE 'Skipping GL insert for journal_entry % because account code is NULL', NEW.id;
    RETURN NEW;
  END IF;

  -- cek apakah general_ledger punya kolom description
  SELECT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'general_ledger' AND column_name = 'description'
  ) INTO _has_desc;

  -- Insert baris debit (jika ada & belum pernah dibuat)
  IF COALESCE(NEW.debit, 0) > 0 THEN
    IF NOT EXISTS (
      SELECT 1 FROM public.general_ledger gl
      WHERE gl.journal_entry_id = NEW.id
        AND gl.debit = NEW.debit
        AND COALESCE(gl.credit,0) = 0
        AND gl.account_code = _acct_code
    ) THEN
      IF _has_desc THEN
        _sql := 'INSERT INTO public.general_ledger (id, date, posting_date, account_code, debit, credit, journal_entry_id, description) VALUES ($1,$2,$3,$4,$5,$6,$7,$8)';
        EXECUTE _sql USING gen_random_uuid(), NEW.date, _gl_date, _acct_code, NEW.debit, 0, NEW.id, _desc;
      ELSE
        INSERT INTO public.general_ledger
          (id, date, posting_date, account_code, debit, credit, journal_entry_id)
        VALUES
          (gen_random_uuid(), NEW.date, _gl_date, _acct_code, NEW.debit, 0, NEW.id);
      END IF;
    END IF;
  END IF;

  -- Insert baris credit (jika ada & belum pernah dibuat)
  IF COALESCE(NEW.credit, 0) > 0 THEN
    IF NOT EXISTS (
      SELECT 1 FROM public.general_ledger gl
      WHERE gl.journal_entry_id = NEW.id
        AND gl.credit = NEW.credit
        AND COALESCE(gl.debit,0) = 0
        AND gl.account_code = _acct_code
    ) THEN
      IF _has_desc THEN
        _sql := 'INSERT INTO public.general_ledger (id, date, posting_date, account_code, debit, credit, journal_entry_id, description) VALUES ($1,$2,$3,$4,$5,$6,$7,$8)';
        EXECUTE _sql USING gen_random_uuid(), NEW.date, _gl_date, _acct_code, 0, NEW.credit, NEW.id, _desc;
      ELSE
        INSERT INTO public.general_ledger
          (id, date, posting_date, account_code, debit, credit, journal_entry_id)
        VALUES
          (gen_random_uuid(), NEW.date, _gl_date, _acct_code, 0, NEW.credit, NEW.id);
      END IF;
    END IF;
  END IF;

  RETURN NEW;
END;
$_$;


ALTER FUNCTION public.create_gl_from_journal() OWNER TO postgres;

--
-- Name: create_journal_for_sales(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_journal_for_sales(p_sales_id uuid) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_sales      sales_transactions%ROWTYPE;
  v_journal_id uuid;
BEGIN
  -- Ambil data sales
  SELECT *
  INTO v_sales
  FROM sales_transactions
  WHERE id = p_sales_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Sales transaction % not found', p_sales_id;
  END IF;

  -- Insert ke journal_entries saja
  INSERT INTO journal_entries (
    id,
    date,
    description,
    source_table,
    source_id,
    sales_transactions_id,
    total_debit,
    total_credit,
    debit,
    credit
  )
  VALUES (
    gen_random_uuid(),
    COALESCE(v_sales.transactions_date, now()),
    CONCAT('Penjualan ', v_sales.invoice_number),
    'sales_transaction',
    v_sales.id,
    v_sales.id,
    total_amount,
    total_amount,
    total_amount,
    total_amount
  )
  RETURNING id INTO v_journal_id;

  RETURN v_journal_id;
END;
$$;


ALTER FUNCTION public.create_journal_for_sales(p_sales_id uuid) OWNER TO postgres;

--
-- Name: create_journal_from_adjustment(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_journal_from_adjustment() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  INSERT INTO journal_entries 
      (id, date, description, account_number, 
       total_debit, total_credit, debit, credit, stock_adjustment_id)
  SELECT 
      gen_random_uuid(),
      NEW.transaction_date,
      'Stock Adjustment ' || NEW.reference_number,

      -- Ambil langsung dari tabel stock
      s.coa_account_code,

      abs(NEW.quantity) * s.selling_price_after_ppn,
      abs(NEW.quantity) * s.selling_price_after_ppn,

      CASE 
        WHEN NEW.quantity > 0 
          THEN abs(NEW.quantity) * s.selling_price_after_ppn
        ELSE 0 
      END,

      CASE 
        WHEN NEW.quantity > 0 
          THEN abs(NEW.quantity) * s.selling_price_after_ppn
        ELSE 0 
      END,

      NEW.id
  FROM stock s
  WHERE s.id = NEW.stock_id;

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.create_journal_from_adjustment() OWNER TO postgres;

--
-- Name: create_journal_from_cash_disbursement(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_journal_from_cash_disbursement() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    cash_account TEXT;
BEGIN
    -- otomatis ambil akun kas/bank yang benar dari COA
    SELECT account_code INTO cash_account
    FROM chart_of_accounts
    WHERE 
        (account_name ILIKE '%kas%' 
        OR account_name ILIKE '%bank%')
    LIMIT 1;

    IF cash_account IS NULL THEN
        RAISE EXCEPTION 'Tidak ditemukan akun Kas atau Bank di COA. Harap tambahkan terlebih dahulu.';
    END IF;

    -- cek apakah account_code valid dalam COA
    IF NOT EXISTS (
        SELECT 1 FROM chart_of_accounts
        WHERE account_code = NEW.account_code
    ) THEN
        RAISE EXCEPTION 'Akun % tidak ada di COA. Input tidak valid.', NEW.account_code;
    END IF;

    -- DEBIT
    INSERT INTO journal_entries (
        transaction_date,
        description,
        account_code,
        debit,
        credit
    )
    VALUES (
        NEW.transaction_date,
        NEW.description,
        NEW.account_code,
        NEW.amount,
        0
    );

    -- KREDIT
    INSERT INTO journal_entries (
        transaction_date,
        description,
        account_code,
        debit,
        credit
    )
    VALUES (
        NEW.transaction_date,
        NEW.description,
        cash_account,
        0,
        NEW.amount
    );

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.create_journal_from_cash_disbursement() OWNER TO postgres;

--
-- Name: create_monthly_tax_reminders(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_monthly_tax_reminders() RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
  current_year INTEGER := EXTRACT(YEAR FROM CURRENT_DATE);
  current_month INTEGER := EXTRACT(MONTH FROM CURRENT_DATE);
  next_month INTEGER;
  next_year INTEGER;
BEGIN
  IF current_month = 12 THEN
    next_month := 1;
    next_year := current_year + 1;
  ELSE
    next_month := current_month + 1;
    next_year := current_year;
  END IF;
  
  INSERT INTO tax_reminders (reminder_type, due_date, period_month, period_year, notes)
  VALUES 
    ('SPT Masa PPN', 
     DATE(next_year || '-' || next_month || '-20'), 
     current_month, 
     current_year, 
     'Batas pelaporan SPT Masa PPN tanggal 20 bulan berikutnya')
  ON CONFLICT DO NOTHING;
END;
$$;


ALTER FUNCTION public.create_monthly_tax_reminders() OWNER TO postgres;

