  SELECT COALESCE(MAX(CAST(SUBSTRING(contract_number FROM 5) AS INTEGER)), 0) + 1
  INTO next_number
  FROM employment_contracts
  WHERE contract_number ~ '^CNT[0-9]+$';
  
  contract_number := 'CNT' || LPAD(next_number::TEXT, 5, '0');
  RETURN contract_number;
END;
$_$;


