--

CREATE FUNCTION public.auto_update_gl() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  INSERT INTO general_ledger 
  (journal_id, account_code, debit, credit, transaction_date)
  VALUES 
  (NEW.id, NEW.account_code, NEW.debit, NEW.credit, NEW.transaction_date);

  RETURN NEW;
END;
$$;


