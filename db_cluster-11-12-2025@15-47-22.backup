ALTER TABLE public.chart_of_accounts_backup OWNER TO postgres;

--
-- Name: cash_disbursement_with_account_name; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.cash_disbursement_with_account_name AS
 SELECT cd.id,
    cd.created_at,
    cd.updated_at,
    cd.transaction_date,
    cd.document_number,
    cd.payment_method,
    cd.bank_account,
    cd.payee_name,
    cd.description,
    cd.category,
    cd.amount,
    cd.attachment_url,
    cd.approval_status,
    cd.approved_by,
    cd.approved_at,
    cd.rejection_reason,
    cd.journal_ref,
    cd.notes,
    cd.created_by,
    cd.bukti,
    cd.account_code,
    cd.status,
    cd.evidence_url,
    cd.cost_center_id,
    cd.tax_amount,
    cd.tax_type,
    cd.tax_code,
    cd.currency_code,
    cd.exchange_rate,
    cd.normalized_amount,
    cd.ocr_data,
    cd.coa_id,
    cd.account_name,
    cd.ocr_id,
    cd.bank_account_id,
    cd.cash_account_id,
    cd.coa_cash_id,
    cd.coa_expense_id,
    coa_cash.account_name AS cash_account_name,
    coa_exp.account_name AS expense_account_name
   FROM ((public.cash_disbursement cd
     LEFT JOIN public.chart_of_accounts_backup coa_cash ON ((coa_cash.id = cd.coa_cash_id)))
     LEFT JOIN public.chart_of_accounts_backup coa_exp ON ((coa_exp.id = cd.coa_expense_id)));


ALTER VIEW public.cash_disbursement_with_account_name OWNER TO postgres;

