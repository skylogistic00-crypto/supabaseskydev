--
-- Name: employees hrd_staff_view_self; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY hrd_staff_view_self ON public.employees FOR SELECT TO authenticated USING (((public.get_user_role() = 'hrd_staff'::text) AND (id = public.get_user_employee_id())));


--
-- Name: employees hrd_supervisor_view_department; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY hrd_supervisor_view_department ON public.employees FOR SELECT TO authenticated USING (((public.get_user_role() = 'hrd_supervisor'::text) AND
CASE
    WHEN (EXISTS ( SELECT 1
       FROM information_schema.columns
      WHERE (((columns.table_name)::name = 'employees'::name) AND ((columns.column_name)::name = 'department_id'::name)))) THEN (department_id = public.get_user_department())
    ELSE false
END));


