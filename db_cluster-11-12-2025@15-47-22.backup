--
-- Name: insert_general_ledger(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.insert_general_ledger() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_date date;
BEGIN
  -- Safely derive a date
  SELECT COALESCE(je.date, je.entry_date, CURRENT_DATE)
  INTO v_date
  FROM public.journal_entries je
  WHERE je.id = NEW.journal_entry_id;

  INSERT INTO public.general_ledger (
    journal_entry_id,
    account_code,
    date,
    description,
    debit,
    credit,
    created_at,
    updated_at
  )
  VALUES (
    NEW.journal_entry_id,
    NEW.account_code,
    v_date,
    NEW.description,
    COALESCE(NEW.debit, 0),
    COALESCE(NEW.credit, 0),
    now(),
    now()
  )
  ON CONFLICT (journal_entry_id, account_code) DO UPDATE
  SET description = EXCLUDED.description,
      debit = EXCLUDED.debit,
      credit = EXCLUDED.credit,
      updated_at = now();

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.insert_general_ledger() OWNER TO postgres;

--
-- Name: insert_journal_entries_disabled(jsonb); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.insert_journal_entries_disabled(entries jsonb) RETURNS void
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  entry JSONB;
BEGIN
  FOR entry IN SELECT * FROM jsonb_array_elements(entries)
  LOOP
    INSERT INTO journal_entries (
      transaction_id,
      transaction_date,
      account_code,
      account_name,
      debit,
      credit,
      description,
      created_by,
      entry_date
    ) VALUES (
      (entry->>'transaction_id')::TEXT,
      COALESCE((entry->>'transaction_date')::DATE, CURRENT_DATE),
      COALESCE((entry->>'account_code')::TEXT, '1-1100'),
      COALESCE((entry->>'account_name')::TEXT, 'Unknown'),
      COALESCE((entry->>'debit')::DECIMAL, 0),
      COALESCE((entry->>'credit')::DECIMAL, 0),
      COALESCE((entry->>'description')::TEXT, ''),
      COALESCE((entry->>'created_by')::TEXT, 'system'),
      COALESCE((entry->>'transaction_date')::DATE, CURRENT_DATE)
    );
  END LOOP;
EXCEPTION
  WHEN OTHERS THEN
    RAISE EXCEPTION 'Error inserting journal entries: %', SQLERRM;
END;
$$;


ALTER FUNCTION public.insert_journal_entries_disabled(entries jsonb) OWNER TO postgres;

