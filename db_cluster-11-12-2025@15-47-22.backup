--
-- Name: tr_gl_sync_trial_balance(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.tr_gl_sync_trial_balance() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_start_old date;
  v_start_new date;
  v_ac_old text;
  v_ac_new text;
BEGIN
  v_start_old := CASE WHEN TG_OP IN ('UPDATE','DELETE') THEN date_trunc('month', OLD.posting_date)::date END;
  v_start_new := CASE WHEN TG_OP IN ('INSERT','UPDATE') THEN date_trunc('month', NEW.posting_date)::date END;
  v_ac_old    := CASE WHEN TG_OP IN ('UPDATE','DELETE') THEN OLD.account_code END;
  v_ac_new    := CASE WHEN TG_OP IN ('INSERT','UPDATE') THEN NEW.account_code END;

  -- Recalc untuk (old_date, old_account) jika ada
  IF v_start_old IS NOT NULL AND v_ac_old IS NOT NULL THEN
    PERFORM public.recalc_trial_balance_period(v_start_old, v_ac_old);
  END IF;

  -- Recalc untuk (new_date, new_account) jika beda dari old atau pada insert
  IF v_start_new IS NOT NULL AND v_ac_new IS NOT NULL THEN
    IF v_start_new IS DISTINCT FROM v_start_old OR v_ac_new IS DISTINCT FROM v_ac_old THEN
      PERFORM public.recalc_trial_balance_period(v_start_new, v_ac_new);
    END IF;
  END IF;

  IF TG_OP = 'DELETE' THEN
    RETURN OLD;
  ELSE
    RETURN NEW;
  END IF;
END;
$$;


ALTER FUNCTION public.tr_gl_sync_trial_balance() OWNER TO postgres;

--
-- Name: tr_je_account_number_sync_gl(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.tr_je_account_number_sync_gl() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF COALESCE(NEW.account_number,'') IS DISTINCT FROM COALESCE(OLD.account_number,'') THEN
    PERFORM public.repost_gl_for_journal_entry(NEW.id);
  END IF;
  RETURN NEW;
END;
$$;


