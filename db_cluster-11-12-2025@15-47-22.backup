--
-- Name: fn_after_stock_adjustment(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_after_stock_adjustment() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_account TEXT;          -- untuk menampung coa_account_code dari stock
    v_value NUMERIC(18,2);   -- nilai adjustment
BEGIN
    -- 1. Ambil account number (coa) dari tabel stock
    SELECT coa_account_code INTO v_account
    FROM stock
    WHERE id = NEW.stock_id;

    -- 2. Hitung nilai penyesuaian
    v_value := ABS(NEW.quantity * NEW.unit_cost);

    -- 3. Jika quantity bertambah → DEBIT persediaan
    IF NEW.quantity > 0 THEN
        INSERT INTO journal_entries (
            date,
            account_number,      -- kolom di journal_entries
            debit,
            credit,
            total_debit,
            total_credit,
            description,
            reference_id,
            reference_type
        ) VALUES (
            NEW.date,
            v_account,           -- isi dengan coa_account_code dari stock
            v_value,
            0,
            v_value,
            0,
            'Penyesuaian penambahan stok',
            NEW.id,
            'stock_adjustment'
        );

    -- 4. Jika quantity berkurang → CREDIT persediaan
    ELSIF NEW.quantity < 0 THEN
        INSERT INTO journal_entries (
            date,
            account_number,
            debit,
            credit,
            total_debit,
            total_credit,
            description,
            reference_id,
            reference_type
        ) VALUES (
            NEW.date,
            v_account,           -- isi COA ke journal entries
            0,
            v_value,
            0,
            v_value,
            'Penyesuaian pengurangan stok',
            NEW.id,
            'stock_adjustment'
        );
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.fn_after_stock_adjustment() OWNER TO postgres;

--
-- Name: fn_check_large_transactions(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_check_large_transactions() RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
  rec RECORD;
  avg_amt numeric;
  stddev_amt numeric;
  threshold numeric;
BEGIN
  SELECT AVG(amount) as avg_amt, STDDEV_POP(amount) as stddev_amt INTO avg_amt, stddev_amt FROM transactions WHERE created_at > now() - interval '30 days';
  threshold := COALESCE(avg_amt,0) + 3 * COALESCE(stddev_amt,0);

  FOR rec IN SELECT * FROM transactions WHERE amount > threshold LOOP
    INSERT INTO anomalies(reason, payload) VALUES ('Large txn', to_jsonb(rec));
  END LOOP;
END;
$$;


ALTER FUNCTION public.fn_check_large_transactions() OWNER TO postgres;

--
-- Name: fn_income_statement(date, date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_income_statement(p_start date, p_end date) RETURNS TABLE(sort_section integer, section text, account_code text, account_name text, debit_total numeric, credit_total numeric, saldo numeric, is_total boolean, note text)
    LANGUAGE sql
    AS $$
  WITH je AS (
    SELECT i.account_code, i.debit::numeric, i.credit::numeric, j."date"::date
    FROM public.journal_entry_items i
    JOIN public.journal_entries j ON j.id = i.journal_entry_id
    WHERE j."date" >= p_start
      AND j."date" <  (p_end + INTERVAL '1 day')
  ),
  coa AS (
    SELECT account_code, account_name, account_type, normal_balance
    FROM public.chart_of_accounts
  ),
  base AS (
    SELECT c.account_type, c.account_code, c.account_name, c.normal_balance,
           SUM(je.debit) AS debit_total, SUM(je.credit) AS credit_total
    FROM je
    JOIN coa c ON c.account_code = je.account_code
    WHERE c.account_type IN ('Pendapatan','Beban Pokok Penjualan','Beban Operasional')
    GROUP BY c.account_type, c.account_code, c.account_name, c.normal_balance
  ),
  calc AS (
    SELECT account_type, account_code, account_name, debit_total, credit_total,
           CASE WHEN COALESCE(normal_balance,'Debit') ILIKE 'Kredit'
                THEN credit_total - debit_total
                ELSE debit_total - credit_total END AS saldo
    FROM base
  ),
  section_tot AS (
    SELECT account_type, SUM(debit_total) AS debit_total, SUM(credit_total) AS credit_total, SUM(saldo) AS saldo
    FROM calc
    GROUP BY account_type
  ),
  p AS (SELECT COALESCE(SUM(saldo),0) AS total_pendapatan FROM section_tot WHERE account_type='Pendapatan'),
  bpp AS (SELECT COALESCE(SUM(saldo),0) AS total_bpp FROM section_tot WHERE account_type='Beban Pokok Penjualan'),
  bo AS (SELECT COALESCE(SUM(saldo),0) AS total_beban_operasional FROM section_tot WHERE account_type='Beban Operasional'),
  laba_kotor AS (SELECT (SELECT total_pendapatan FROM p) - (SELECT total_bpp FROM bpp) AS nilai),
  laba_bersih AS (SELECT (SELECT nilai FROM laba_kotor) - (SELECT total_beban_operasional FROM bo) AS nilai)

  SELECT
    CASE account_type WHEN 'Pendapatan' THEN 10 WHEN 'Beban Pokok Penjualan' THEN 20 WHEN 'Beban Operasional' THEN 30 END,
    account_type, account_code, account_name, debit_total, credit_total, saldo, FALSE, NULL
  FROM calc
  UNION ALL
  SELECT
    CASE account_type WHEN 'Pendapatan' THEN 10 WHEN 'Beban Pokok Penjualan' THEN 20 WHEN 'Beban Operasional' THEN 30 END,
    account_type || ' - TOTAL', NULL, NULL, debit_total, credit_total, saldo, TRUE, NULL
  FROM section_tot
  UNION ALL
  SELECT 40, 'LABA KOTOR', NULL, NULL, NULL, NULL, (SELECT nilai FROM laba_kotor), TRUE, 'Pendapatan - Beban Pokok Penjualan'
  UNION ALL
  SELECT 50, 'LABA BERSIH', NULL, NULL, NULL, NULL, (SELECT nilai FROM laba_bersih), TRUE, 'Laba Kotor - Beban Operasional'
  ORDER BY 1, 8, 2, 3 NULLS LAST;
$$;


ALTER FUNCTION public.fn_income_statement(p_start date, p_end date) OWNER TO postgres;

--
-- Name: fn_post_cogs_on_stock_out(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_post_cogs_on_stock_out() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  item RECORD;
  journal_id uuid;
  debit_account uuid; -- ganti dengan account id/hardcode jika perlu
  credit_account uuid;
  total_cost numeric;
BEGIN
  IF NEW.movement_type IS DISTINCT FROM 'out' THEN
    RETURN NEW;
  END IF;

  -- ambil item info (unit_cost)
  SELECT * INTO item FROM stock_items WHERE id = NEW.stock_item_id LIMIT 1;

  IF item IS NULL THEN
    RAISE NOTICE 'stock_item not found %', NEW.stock_item_id;
    RETURN NEW;
  END IF;

  total_cost := COALESCE(NEW.unit_cost, item.average_cost, 0) * COALESCE(NEW.qty,0);

  -- tentukan account_id (ganti dengan method lookup chart_of_accounts anda)
  -- contoh: account code '5-1000' = HPP, '1-1105' = Inventory
  SELECT id INTO debit_account FROM chart_of_accounts WHERE account_code = '5-1000' LIMIT 1;
  SELECT id INTO credit_account FROM chart_of_accounts WHERE account_code = '1-1105' LIMIT 1;

  -- create journal header
  INSERT INTO journal_entries(description, transaction_type, amount)
    VALUES (CONCAT('COGS for stock_out ', NEW.id), 'cogs', total_cost)
    RETURNING id INTO journal_id;

  -- debit HPP
  INSERT INTO journal_entry_lines(journal_id, account_id, debit, credit, description)
    VALUES (journal_id, debit_account, total_cost, 0, 'HPP - material');

  -- credit Inventory
  INSERT INTO journal_entry_lines(journal_id, account_id, debit, credit, description)
    VALUES (journal_id, credit_account, 0, total_cost, 'Inventory decrease');

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.fn_post_cogs_on_stock_out() OWNER TO postgres;

--
-- Name: fn_post_membership_payment(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_post_membership_payment() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  journal_id uuid;
  cash_acc uuid;
  deferred_acc uuid;
BEGIN
  IF NEW.payment_type IS DISTINCT FROM 'membership' THEN
    RETURN NEW;
  END IF;

  SELECT id INTO cash_acc FROM chart_of_accounts WHERE account_code = '1-1000' LIMIT 1;
  SELECT id INTO deferred_acc FROM chart_of_accounts WHERE account_code = '2-4000' LIMIT 1; -- revenue received in advance

  INSERT INTO journal_entries(description, transaction_type, amount)
    VALUES (CONCAT('Membership payment ', NEW.id), 'membership_payment', NEW.amount)
    RETURNING id INTO journal_id;

  INSERT INTO journal_entry_lines(journal_id, account_id, debit, credit, description)
    VALUES (journal_id, cash_acc, NEW.amount, 0, 'Kas masuk - membership');

  INSERT INTO journal_entry_lines(journal_id, account_id, debit, credit, description)
    VALUES (journal_id, deferred_acc, 0, NEW.amount, 'Pendapatan diterima dimuka');

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.fn_post_membership_payment() OWNER TO postgres;

--
-- Name: fn_post_monthly_depreciation(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_post_monthly_depreciation() RETURNS void
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  a RECORD;
  monthly_amount numeric;
  journal_id uuid;
  exp_dep uuid;
  acc_dep uuid;
BEGIN
  FOR a IN SELECT * FROM assets WHERE active = true LOOP
    monthly_amount := (a.purchase_price - COALESCE(a.residual_value,0)) / GREATEST(a.useful_life_months,1);

    -- account lookups
    SELECT id INTO exp_dep FROM chart_of_accounts WHERE account_code = '6-3000' LIMIT 1; -- Beban Penyusutan
    SELECT id INTO acc_dep FROM chart_of_accounts WHERE account_code = '1-1900' LIMIT 1; -- Akumulasi Penyusutan (liability/equity area, adapt)

    INSERT INTO journal_entries(description, transaction_type, amount)
      VALUES (CONCAT('Monthly depreciation ', a.id), 'depreciation', monthly_amount)
      RETURNING id INTO journal_id;

    INSERT INTO journal_entry_lines(journal_id, account_id, debit, credit, description)
      VALUES (journal_id, exp_dep, monthly_amount, 0, 'Beban Penyusutan');

    INSERT INTO journal_entry_lines(journal_id, account_id, debit, credit, description)
      VALUES (journal_id, acc_dep, 0, monthly_amount, 'Akumulasi Penyusutan');

    -- update accumulated in assets
    UPDATE assets SET accumulated_depreciation = COALESCE(accumulated_depreciation,0) + monthly_amount WHERE id = a.id;
  END LOOP;
END;
$$;


ALTER FUNCTION public.fn_post_monthly_depreciation() OWNER TO postgres;

--
-- Name: fn_pr_to_stock(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_pr_to_stock() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
declare
  generated_sku text;
  supp_name text;
begin
  -- Generate SKU otomatis
  generated_sku := 'PR-' ||
                   to_char(now(), 'DDMMYYYY') || '-' ||
                   lpad((floor(random()*10000))::text, 4, '0');

  -- Ambil supplier_name dari tabel suppliers
  select s.supplier_name 
  into supp_name
  from public.suppliers s
  where s.id = NEW.supplier_id;

  -- Jika tidak ada supplier_name, isi default
  if supp_name is null then
    supp_name := 'Unknown Supplier';
  end if;

  -- Jalankan jika status berubah menjadi COMPLETED
  if NEW.status = 'COMPLETED' and OLD.status <> 'COMPLETED' then
  
    insert into stock (
      item_name,
      item_quantity,
      purchase_price,
      supplier_id,
      supplier_name,
      unit,
      created_by,
      item_arrival_date,
      lots,
      sku
    )
    values (
      NEW.item_name,
      NEW.quantity,
      NEW.unit_price,
      NEW.supplier_id,
      supp_name,
      NEW.unit,
      NEW.requester_id,
      now(),
      coalesce(NEW.request_code, 'LOT-' || NEW.id),
      generated_sku
    );

  end if;

  return NEW;
end;
$$;


ALTER FUNCTION public.fn_pr_to_stock() OWNER TO postgres;

--
-- Name: fn_sync_gl_from_je_items(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_sync_gl_from_je_items() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_date date;
  v_desc text;
BEGIN
  IF TG_OP = 'DELETE' THEN
    DELETE FROM public.general_ledger
    WHERE journal_item_id = OLD.id;
    RETURN OLD;
  END IF;

  -- Ambil tanggal & deskripsi dari header JE (fallback jika item tidak punya deskripsi)
  SELECT j."date",
         COALESCE(i.description, j.description)
    INTO v_date, v_desc
  FROM public.journal_entries j
  JOIN public.journal_entry_items i ON i.journal_entry_id = j.id
  WHERE i.id = COALESCE(NEW.id, OLD.id);

  -- Upsert ke GL berdasarkan journal_item_id (unik)
  INSERT INTO public.general_ledger AS gl
    (journal_entry_id, journal_item_id, account_code, "date",
     description, debit, credit, created_at, updated_at)
  VALUES
    (NEW.journal_entry_id, NEW.id, NEW.account_code, v_date,
     v_desc, COALESCE(NEW.debit,0), COALESCE(NEW.credit,0), now(), now())
  ON CONFLICT (journal_item_id) DO UPDATE
  SET account_code = EXCLUDED.account_code,
      "date"       = EXCLUDED."date",
      description  = EXCLUDED.description,
      debit        = EXCLUDED.debit,
      credit       = EXCLUDED.credit,
      updated_at   = now();

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.fn_sync_gl_from_je_items() OWNER TO postgres;

--
-- Name: fn_sync_kas_account_number_from_je(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_sync_kas_account_number_from_je() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- INSERT/UPDATE
  IF NEW.source_table = 'kas_transaksi' THEN
    UPDATE public.kas_transaksi
    SET account_number = NEW.account_code
    WHERE id = NEW.source_id
      AND COALESCE(account_number,'') IS DISTINCT FROM COALESCE(NEW.account_code,'');
  END IF;

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.fn_sync_kas_account_number_from_je() OWNER TO postgres;

--
-- Name: fn_update_coa_balance(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.fn_update_coa_balance() RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
    UPDATE chart_of_accounts coa
    SET current_balance = sub.total_balance
    FROM (
        SELECT 
            g.account_code,
            CASE 
                WHEN coa.normal_balance = 'Debit' 
                    THEN COALESCE(SUM(g.debit), 0) - COALESCE(SUM(g.credit), 0)
                WHEN coa.normal_balance = 'Credit' 
                    THEN COALESCE(SUM(g.credit), 0) - COALESCE(SUM(g.debit), 0)
                ELSE 0
            END AS total_balance
        FROM general_ledger g
        JOIN chart_of_accounts coa ON coa.account_code = g.account_code
        GROUP BY g.account_code, coa.normal_balance
    ) AS sub
    WHERE coa.account_code = sub.account_code;
END;
$$;


ALTER FUNCTION public.fn_update_coa_balance() OWNER TO postgres;

--
-- Name: gen_stock_code(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.gen_stock_code() RETURNS text
    LANGUAGE plpgsql
    AS $$DECLARE v text;
BEGIN
  LOOP
    v := 'STK-' || to_char(now(),'YYMMDD') || '-' ||
         substr(encode(gen_random_bytes(4),'hex'),1,8);
    -- pastikan belum dipakai
    EXIT WHEN NOT EXISTS (SELECT 1 FROM public.stock WHERE stock_code = v);
  END LOOP;
  RETURN v;
END;$$;


