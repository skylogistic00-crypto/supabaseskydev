-- Name: tr_kas_sync_account_number_to_je(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.tr_kas_sync_account_number_to_je() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- Update JE yang berasal dari kas_transaksi ini
  UPDATE public.journal_entries je
  SET account_number = NEW.account_number
  WHERE je.source_table = 'kas_transaksi'
    AND je.source_id    = NEW.id
    AND COALESCE(je.account_number, '') <> COALESCE(NEW.account_number, '');

  RETURN NEW;
END;
$$;


