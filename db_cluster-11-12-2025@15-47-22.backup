--
-- Name: generate_laba_rugi(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_laba_rugi() RETURNS TABLE(type text, amount numeric)
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY
    SELECT 'Pendapatan', SUM(credit - debit)
    FROM journal_entry_lines
    WHERE account_code LIKE '4%';

    RETURN QUERY
    SELECT 'Biaya', SUM(debit - credit)
    FROM journal_entry_lines
    WHERE account_code LIKE '5%';
END;
$$;


