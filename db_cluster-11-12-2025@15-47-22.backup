--
-- Name: borrowers; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.borrowers (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    borrower_code text,
    borrower_name text NOT NULL,
    borrower_type text,
    identity_type text,
    identity_number text,
    phone text,
    email text,
    address text,
    bank_name text,
    bank_account_number text,
    bank_account_name text,
    credit_limit numeric(15,2),
    notes text,
    status text DEFAULT 'Aktif'::text,
    default_late_fee_percentage numeric(5,2) DEFAULT 0.1,
    default_tax_type character varying(50),
    default_tax_percentage numeric(5,2) DEFAULT 0,
    loan_calculation_method text DEFAULT 'Anuitas'::text,
    CONSTRAINT borrowers_borrower_type_check CHECK ((borrower_type = ANY (ARRAY['Individu'::text, 'Perusahaan'::text, 'Lembaga'::text]))),
    CONSTRAINT borrowers_identity_type_check CHECK ((identity_type = ANY (ARRAY['KTP'::text, 'NPWP'::text, 'Passport'::text, 'SIUP'::text, 'NIB'::text]))),
    CONSTRAINT borrowers_loan_calculation_method_check CHECK ((loan_calculation_method = ANY (ARRAY['Anuitas'::text, 'Flat Rate'::text]))),
    CONSTRAINT borrowers_status_check CHECK ((status = ANY (ARRAY['Aktif'::text, 'Tidak Aktif'::text])))
);


ALTER TABLE public.borrowers OWNER TO postgres;

