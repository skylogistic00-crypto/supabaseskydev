-- Name: employees hrd_admin_full_access; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY hrd_admin_full_access ON public.employees TO authenticated USING ((public.get_user_role() = ANY (ARRAY['hrd_admin'::text, 'super_admin'::text, 'hr_manager'::text]))) WITH CHECK ((public.get_user_role() = ANY (ARRAY['hrd_admin'::text, 'super_admin'::text, 'hr_manager'::text])));


--
-- Name: employees hrd_manager_view_all; Type: POLICY; Schema: public; Owner: postgres
