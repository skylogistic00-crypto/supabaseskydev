--
-- Name: smart_find_rule(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.smart_find_rule(p_id uuid) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
declare
  bs record;
  keywords text[];
  r record;
  best_score int := 0;
  score int;
  best jsonb := '{}'::jsonb;
begin
  select * into bs from bank_statements where id = p_id;

  if not found then
    raise exception 'Transaksi % tidak ditemukan', p_id;
  end if;

  keywords := extract_keywords(bs.description);

  for r in
    select * from bank_mutasi_mapping where is_active = true
  loop
    score := 0;

    -- Exact match
    if lower(r.keyword) = any (keywords) then
      score := 100;
    end if;

    -- Partial match
    if score = 0 and position(lower(r.keyword) in lower(bs.description)) > 0 then
      score := 80;
    end if;

    -- Location match
    if score = 0 and r.pos is not null and lower(r.pos) = any(keywords) then
      score := 50;
    end if;

    -- Category fallback
    if score = 0 then
      score := 20;
    end if;

    -- Replace best rule
    if score > best_score then
      best_score := score;
      best := jsonb_build_object(
        'keyword', r.keyword,
        'coa', r.coa_account_code,
        'kategori', r.kategori,
        'pos', r.pos,
        'score', score
      );
    end if;
  end loop;

  return best;
end;
$$;


ALTER FUNCTION public.smart_find_rule(p_id uuid) OWNER TO postgres;

--
-- Name: stock_calc_closing_trg(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.stock_calc_closing_trg() RETURNS trigger
    LANGUAGE plpgsql
    AS $$begin
  -- ✅ 1. Skip perhitungan jika sedang dalam mode manual insert dari upsert_stock()
  if current_setting('app.manual_upsert', true) = 'true' then
    return new;
  end if;

  -- ✅ 2. Hitung stok otomatis hanya jika memang field terkait tidak null
  new.opening_stock := coalesce(new.opening_stock, 0);
  new.stock_in      := coalesce(new.stock_in, 0);
  new.stock_out     := coalesce(new.stock_out, 0);

  new.closing_stock := new.opening_stock + new.stock_in - new.stock_out;

  return new;
end$$;


ALTER FUNCTION public.stock_calc_closing_trg() OWNER TO postgres;

--
-- Name: stock_set_coa_name(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.stock_set_coa_name() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_name text;
BEGIN
  -- Jika coa_account_code kosong, kosongkan coa_account_name juga
  IF NEW.coa_account_code IS NULL OR trim(NEW.coa_account_code) = '' THEN
    NEW.coa_account_name := NULL;
    RETURN NEW;
  END IF;

  -- ambil nama COA jika ada (batasi 1 baris)
  SELECT account_name
  INTO v_name
  FROM chart_of_accounts
  WHERE account_code = NEW.coa_account_code
  LIMIT 1;

  -- jika ditemukan, isi; jika tidak, bisa set NULL atau placeholder
  IF v_name IS NOT NULL THEN
    NEW.coa_account_name := v_name;
  ELSE
    -- opsi: set NULL (lebih aman) atau pakai placeholder
    NEW.coa_account_name := NULL;
    -- NEW.coa_account_name := 'UNMAPPED COA — review';
  END IF;

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.stock_set_coa_name() OWNER TO postgres;

--
-- Name: sync_auth_user_meta_role(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.sync_auth_user_meta_role() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  -- sinkronkan hanya jika role_id berubah
  IF TG_OP = 'UPDATE' AND NEW.role_id IS DISTINCT FROM OLD.role_id THEN
  
    UPDATE auth.users
    SET raw_user_meta_data =
      COALESCE(raw_user_meta_data, '{}'::jsonb)
      || jsonb_build_object(
          'role', NEW.role_name,
          'role_name', NEW.role_name,
          'role_id', NEW.role_id
        )
    WHERE id = NEW.id;  -- id user sama antara public.users dan auth.users

  END IF;

  RETURN NULL; -- AFTER trigger tidak perlu me-return NEW
END;
$$;


ALTER FUNCTION public.sync_auth_user_meta_role() OWNER TO postgres;

--
-- Name: sync_journal_to_gl(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.sync_journal_to_gl() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  INSERT INTO general_ledger (
    journal_entry_id,
    account_code,
    account_name,
    account_type,
    date,
    description,
    debit,
    credit,
    debit_account,
    credit_account
  ) VALUES (
    NEW.id,
    COALESCE(NEW.account_code, NEW.debit_account, ''),
    COALESCE(NEW.account_name, ''),
    COALESCE(NEW.account_type, ''),
    COALESCE(NEW.tanggal, NEW.transaction_date, CURRENT_DATE),
    COALESCE(NEW.description, ''),
    COALESCE(NEW.debit, 0),
    COALESCE(NEW.credit, 0),
    COALESCE(NEW.debit_account, NEW.account_code, ''),
    COALESCE(NEW.credit_account, '')
  );
  
  RETURN NEW;
EXCEPTION
  WHEN OTHERS THEN
    RAISE LOG 'Error syncing to GL: %', SQLERRM;
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.sync_journal_to_gl() OWNER TO postgres;

--
-- Name: sync_qty_stock_in(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.sync_qty_stock_in() RETURNS trigger
    LANGUAGE plpgsql
    AS $$declare
  v int;
begin
  -- Ambil nilai yang diisi user: utamakan stock_in, kalau kosong pakai quantity, default 0
  v := coalesce(NEW.stock_in, NEW.quantity, 0);
  NEW.stock_in := v;
  NEW.quantity := v;
  return NEW;
end$$;


