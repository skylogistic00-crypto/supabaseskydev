--
-- Name: get_user_department(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_user_department() RETURNS uuid
    LANGUAGE plpgsql SECURITY DEFINER
    AS $_$
DECLARE
  user_dept UUID;
  has_dept_id BOOLEAN;
BEGIN
  -- Check if department_id column exists
  SELECT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name = 'employees' AND column_name = 'department_id'
  ) INTO has_dept_id;
  
  IF has_dept_id THEN
    EXECUTE 'SELECT department_id FROM employees WHERE user_id = $1' 
    INTO user_dept USING auth.uid();
  END IF;
  
  RETURN user_dept;
END;
$_$;


ALTER FUNCTION public.get_user_department() OWNER TO postgres;

