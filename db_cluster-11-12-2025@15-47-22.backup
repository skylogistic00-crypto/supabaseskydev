ALTER FUNCTION public.tf_kas_document_number() OWNER TO postgres;

--
-- Name: tf_kas_transaksi_to_journal(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.tf_kas_transaksi_to_journal() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_cash_account_id    uuid;
  v_counter_account_id uuid;
  v_je_id uuid;

  v_entry_date date;
  v_desc text;
  v_amount numeric;

  v_cash_code     CONSTANT text := '1110';
  v_expense_code  CONSTANT text := '2200';
  v_revenue_code  CONSTANT text := '4200';

  v_input_code text;
  v_default_code text;
BEGIN
  -- ambil nilai dinamis dari NEW
  v_entry_date :=
    COALESCE(
      (to_jsonb(NEW)->>'date')::date,
      (to_jsonb(NEW)->>'tanggal')::date,
      (to_jsonb(NEW)->>'transaction_date')::date,
      (to_jsonb(NEW)->>'created_at')::timestamp::date,
      now()::date
    );

  v_desc :=
    COALESCE(
      to_jsonb(NEW)->>'description',
      to_jsonb(NEW)->>'keterangan',
      to_jsonb(NEW)->>'document_number',
      to_jsonb(NEW)->>'no_dokumen',
      ''
    );

  v_amount :=
    COALESCE(
      NULLIF(to_jsonb(NEW)->>'nominal','')::numeric,
      NULLIF(to_jsonb(NEW)->>'amount','')::numeric,
      NULLIF(to_jsonb(NEW)->>'jumlah','')::numeric,
      0
    );
  IF v_amount <= 0 THEN
    RAISE EXCEPTION 'Nominal tidak valid (<= 0).';
  END IF;

  -- akun kas
  SELECT id INTO v_cash_account_id
  FROM public.chart_of_accounts
  WHERE account_code = v_cash_code OR account_name ILIKE '%Kas%'
  LIMIT 1;
  IF v_cash_account_id IS NULL THEN
    RAISE EXCEPTION 'Akun Kas (code %) tidak ditemukan di chart_of_accounts.', v_cash_code;
  END IF;

  -- tentukan akun lawan
  v_default_code := CASE WHEN NEW.payment_type = 'Pengeluaran Kas' THEN v_expense_code ELSE v_revenue_code END;
  v_input_code := NULLIF(to_jsonb(NEW)->>'account_number','');

  IF v_input_code IS NOT NULL THEN
    SELECT id INTO v_counter_account_id
    FROM public.chart_of_accounts
    WHERE account_code = v_input_code
    LIMIT 1;
  END IF;

  IF v_counter_account_id IS NULL THEN
    SELECT id INTO v_counter_account_id
    FROM public.chart_of_accounts
    WHERE account_code = v_default_code
    LIMIT 1;
  END IF;

  IF v_counter_account_id IS NULL THEN
    RAISE EXCEPTION 'Akun lawan default % tidak ditemukan di chart_of_accounts.', v_default_code;
  END IF;

  -- idempoten saat UPDATE
  IF TG_OP = 'UPDATE' THEN
    DELETE FROM public.journal_entry_items i
    USING public.journal_entries e
    WHERE i.journal_entry_id = e.id
      AND e.source_table = 'kas_transaksi'
      AND e.source_id = NEW.id;

    DELETE FROM public.journal_entries e
    WHERE e.source_table = 'kas_transaksi'
      AND e.source_id = NEW.id;
  END IF;

  -- header jurnal (pakai kolom "date" di journal_entries)
  v_je_id := gen_random_uuid();
  INSERT INTO public.journal_entries (id, "date", description, source_table, source_id, created_at)
  VALUES (v_je_id, v_entry_date, v_desc, 'kas_transaksi', NEW.id, now());

  -- detail
  IF NEW.payment_type = 'Penerimaan Kas' THEN
    INSERT INTO public.journal_entry_items (journal_entry_id, account_id, debit, credit, description)
    VALUES (v_je_id, v_cash_account_id, v_amount, 0, v_desc);
    INSERT INTO public.journal_entry_items (journal_entry_id, account_id, debit, credit, description)
    VALUES (v_je_id, v_counter_account_id, 0, v_amount, v_desc);
  ELSIF NEW.payment_type = 'Pengeluaran Kas' THEN
    INSERT INTO public.journal_entry_items (journal_entry_id, account_id, debit, credit, description)
    VALUES (v_je_id, v_counter_account_id, v_amount, 0, v_desc);
    INSERT INTO public.journal_entry_items (journal_entry_id, account_id, debit, credit, description)
    VALUES (v_je_id, v_cash_account_id, 0, v_amount, v_desc);
  ELSE
    RAISE EXCEPTION 'payment_type % tidak valid. Gunakan "Penerimaan Kas" / "Pengeluaran Kas".', NEW.payment_type;
  END IF;

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.tf_kas_transaksi_to_journal() OWNER TO postgres;

