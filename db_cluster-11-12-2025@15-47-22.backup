--
-- Name: generate_shipper_code(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_shipper_code() RETURNS trigger
    LANGUAGE plpgsql
    AS $_$
DECLARE
  next_number INTEGER;
  new_code TEXT;
BEGIN
  SELECT COALESCE(MAX(CAST(SUBSTRING(shipper_code FROM 4) AS INTEGER)), 0) + 1
  INTO next_number
  FROM shippers
  WHERE shipper_code ~ '^SHP[0-9]+$';
  
  new_code := 'SHP' || LPAD(next_number::TEXT, 4, '0');
  
  NEW.shipper_code := new_code;
  
  RETURN NEW;
END;
$_$;


ALTER FUNCTION public.generate_shipper_code() OWNER TO postgres;

--
-- Name: generate_stock_sku(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_stock_sku() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  next_num bigint;
BEGIN
  -- kalau SKU belum diisi manual, generate otomatis
  IF NEW.sku IS NULL OR trim(NEW.sku) = '' THEN
    SELECT nextval('stock_sku_seq') INTO next_num;

    -- format: SKU-000001, SKU-000002, dst
    NEW.sku := 'SKU-' || to_char(next_num, 'FM000000');
  END IF;

  -- kode_barang ikut ambil dari sku (kecuali kalau sudah diisi manual)
  IF NEW.kode_barang IS NULL OR trim(NEW.kode_barang) = '' THEN
    NEW.kode_barang := NEW.sku;
  END IF;

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.generate_stock_sku() OWNER TO postgres;

--
-- Name: generate_stock_sku_uuid(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_stock_sku_uuid() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- kalau sku belum diisi, generate dari UUID
  IF NEW.sku IS NULL OR trim(NEW.sku) = '' THEN
    -- ambil 8 karakter pertama dari UUID biar pendek
    NEW.sku := 'SKU-' || substring(gen_random_uuid()::text FROM 1 FOR 8);
  END IF;

  -- kode_barang ikut ambil dari sku kalau belum diisi
  IF NEW.kode_barang IS NULL OR trim(NEW.kode_barang) = '' THEN
    NEW.kode_barang := NEW.sku;
  END IF;

  RETURN NEW;
END;
$$;


ALTER FUNCTION public.generate_stock_sku_uuid() OWNER TO postgres;

--
-- Name: generate_supplier_code(text, integer); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_supplier_code(prefix text DEFAULT 'SUP'::text, pad_len integer DEFAULT 3) RETURNS text
    LANGUAGE plpgsql
    AS $$
DECLARE last_num int;
BEGIN
  SELECT COALESCE(MAX((regexp_replace(supplier_code,'\D','','g'))::int), 0)
  INTO last_num
  FROM public.suppliers
  WHERE supplier_code LIKE prefix || '%';

  RETURN prefix || LPAD((last_num + 1)::text, pad_len, '0');
END; $$;


ALTER FUNCTION public.generate_supplier_code(prefix text, pad_len integer) OWNER TO postgres;

--
-- Name: generate_trial_balance(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_trial_balance() RETURNS TABLE(account_code text, total_debit numeric, total_credit numeric)
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY
    SELECT account_code,
           SUM(debit) AS total_debit,
           SUM(credit) AS total_credit
    FROM journal_entry_lines
    GROUP BY account_code
    ORDER BY account_code;
END;
$$;


