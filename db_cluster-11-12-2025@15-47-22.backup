--

CREATE TABLE public.inventory_items (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    nama_barang text NOT NULL,
    sku text NOT NULL,
    kode_barang text,
    nomor_batch_lot text,
    nomor_seri text,
    jenis_barang text,
    asal_barang text,
    nomor_dokumen_pabean text,
    tanggal_masuk date NOT NULL,
    lama_simpan integer,
    berat numeric(10,2),
    volume numeric(10,2),
    lokasi text,
    status text NOT NULL,
    keterangan text,
    harga_per_unit numeric(15,2),
    total_biaya numeric(15,2),
    mata_uang text DEFAULT 'IDR'::text,
    akun_persediaan text,
    dibuat_oleh text,
    tanggal_posting_ceisa date,
    sync_status text DEFAULT 'Belum Terkirim'::text,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    item_id uuid,
    line text,
    qty_available numeric DEFAULT 0,
    cost_per_unit numeric,
    coa_inventory_code text,
    coa_cogs_code text,
    CONSTRAINT inventory_items_asal_barang_check CHECK ((asal_barang = ANY (ARRAY['Impor'::text, 'Lokal'::text, 'Produksi Dalam Negeri'::text]))),
    CONSTRAINT inventory_items_jenis_barang_check CHECK ((jenis_barang = ANY (ARRAY['Berikat'::text, 'Non-Berikat'::text]))),
    CONSTRAINT inventory_items_mata_uang_check CHECK ((mata_uang = ANY (ARRAY['IDR'::text, 'USD'::text]))),
    CONSTRAINT inventory_items_status_check CHECK ((status = ANY (ARRAY['Tersedia'::text, 'Terpakai'::text, 'Dipindahkan'::text, 'Rusak'::text]))),
    CONSTRAINT inventory_items_sync_status_check CHECK ((sync_status = ANY (ARRAY['Belum Terkirim'::text, 'Terkirim ke WMS'::text, 'Terkirim ke CEISA'::text, 'Selesai'::text])))
);


