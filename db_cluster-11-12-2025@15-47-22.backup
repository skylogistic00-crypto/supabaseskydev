-- Name: update_parent_id_from_parent_code(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_parent_id_from_parent_code() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF NEW.parent_code IS NOT NULL THEN
    NEW.parent_id := (
      SELECT id 
      FROM chart_of_accounts 
      WHERE account_code = NEW.parent_code
    );
  ELSE
    NEW.parent_id := NULL;
  END IF;
  RETURN NEW;
END;
$$;


