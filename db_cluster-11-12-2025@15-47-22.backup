--
-- Name: update_stock_after_adjustment(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_stock_after_adjustment() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- Only update stock if status is approved
  IF NEW.status = 'approved' THEN
    -- Update stock quantity based on adjustment value
    UPDATE stock
    SET 
      quantity = COALESCE(quantity, 0) + NEW.adjustment_value,
      updated_at = NOW()
    WHERE sku = NEW.sku;
    
    -- Log if stock not found
    IF NOT FOUND THEN
      RAISE WARNING 'Stock with SKU % not found', NEW.sku;
    END IF;
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.update_stock_after_adjustment() OWNER TO postgres;

--
-- Name: update_stock_after_purchase(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_stock_after_purchase() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- Update stock quantity by adding the purchased quantity
  -- Match by item_name only (simplified to avoid array comparison issues)
  UPDATE stock
  SET 
    quantity = COALESCE(quantity, 0) + NEW.quantity,
    updated_at = NOW()
  WHERE item_name = NEW.item_name;
  
  -- If stock record doesn't exist, log a warning
  IF NOT FOUND THEN
    RAISE WARNING 'Stock record not found for item_name: %', NEW.item_name;
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.update_stock_after_purchase() OWNER TO postgres;

--
-- Name: update_stock_after_purchase_quantity_change(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_stock_after_purchase_quantity_change() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- Adjust stock by the difference between new and old quantity
  UPDATE stock
  SET 
    quantity = COALESCE(quantity, 0) - OLD.quantity + NEW.quantity,
    updated_at = NOW()
  WHERE item_name = NEW.item_name;
  
  IF NOT FOUND THEN
    RAISE WARNING 'Stock record not found for item_name: %', NEW.item_name;
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.update_stock_after_purchase_quantity_change() OWNER TO postgres;

--
-- Name: update_stock_after_sales(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_stock_after_sales() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- Only update stock for 'Barang' (goods) transactions
  IF NEW.transaction_type = 'Barang' THEN
    -- Update stock quantity by reducing it
    UPDATE stock
    SET 
      quantity = quantity - NEW.quantity,
      updated_at = NOW()
    WHERE item_name = NEW.item_name
      AND description = NEW.description;
    
    -- Log if stock not found
    IF NOT FOUND THEN
      RAISE WARNING 'Stock with item_name % and description % not found', NEW.item_name, NEW.description;
    END IF;
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.update_stock_after_sales() OWNER TO postgres;

