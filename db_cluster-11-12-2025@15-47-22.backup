ALTER TABLE public.vendors OWNER TO postgres;

--
-- Name: view_general_ledger; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.view_general_ledger AS
 SELECT j.id AS journal_id,
    j.date,
    j.reference,
    l.account_code,
    l.account_name,
    l.debit,
    l.credit
   FROM (public.journal_entries j
     JOIN public.journal_entry_lines l ON ((j.id = l.journal_id)))
  ORDER BY j.date;


ALTER VIEW public.view_general_ledger OWNER TO postgres;

--
-- Name: vw_all_financial_transactions; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_all_financial_transactions AS
 SELECT id,
    type AS transaction_type,
    transaction_date,
    item_name,
    customer_name,
    supplier_name,
    quantity,
    unit_price,
    subtotal,
    ppn_amount,
    total_amount,
    payment_method,
    payment_type,
    journal_ref,
    notes,
    description,
    target_table,
    approval_status,
    approved_by,
    approved_at,
    created_at
   FROM public.approval_transaksi
  WHERE (approval_status = 'approved'::text)
  ORDER BY transaction_date DESC, created_at DESC;


ALTER VIEW public.vw_all_financial_transactions OWNER TO postgres;

--
-- Name: vw_attendance_with_employee; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_attendance_with_employee AS
 SELECT a.id,
    a.employee_id,
    e.employee_number,
    e.full_name,
    a.attendance_date,
    a.clock_in,
    a.clock_out,
    a.work_hours,
    a.status,
    a.notes,
    a.created_at,
    a.updated_at
   FROM (public.attendance a
     LEFT JOIN public.employees e ON ((a.employee_id = e.id)))
  ORDER BY a.attendance_date DESC, a.clock_in DESC;


ALTER VIEW public.vw_attendance_with_employee OWNER TO postgres;

--
-- Name: vw_cash_flow_report; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_cash_flow_report AS
 SELECT id AS journal_entry_id,
    (created_at)::date AS entry_date,
    description,
    jenis_transaksi,
        CASE
            WHEN (jenis_transaksi = 'Penerimaan Kas'::text) THEN (debit)::numeric
            WHEN (jenis_transaksi = 'Pengeluaran Kas'::text) THEN (- (credit)::numeric)
            ELSE (0)::numeric
        END AS cash_movement,
        CASE
            WHEN (jenis_transaksi = 'Penerimaan Kas'::text) THEN (debit)::numeric
            ELSE (0)::numeric
        END AS cash_in,
        CASE
            WHEN (jenis_transaksi = 'Pengeluaran Kas'::text) THEN (credit)::numeric
            ELSE (0)::numeric
        END AS cash_out
   FROM public.journal_entries je
  WHERE (jenis_transaksi = ANY (ARRAY['Penerimaan Kas'::text, 'Pengeluaran Kas'::text]))
  ORDER BY created_at;


ALTER VIEW public.vw_cash_flow_report OWNER TO postgres;

--
-- Name: vw_customers; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_customers AS
 SELECT c.id,
    c.name,
    c.email,
    c.phone,
    c.address,
    c.created_at,
    c.updated_at,
    c.bank_account_number,
    c.payment_term_id,
    pt.term_name AS payment_term_name,
    pt.days AS payment_term_days
   FROM (public.customers c
     LEFT JOIN public.payment_terms pt ON ((c.payment_term_id = pt.id)));


ALTER VIEW public.vw_customers OWNER TO postgres;

--
-- Name: vw_employee_advance_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_employee_advance_summary AS
 SELECT ea.employee_id,
    ea.employee_name,
    ea.balance AS current_balance,
    COALESCE(sum(
        CASE
            WHEN (eam.movement_type = 'kasbon'::text) THEN eam.amount
            ELSE (0)::numeric
        END), (0)::numeric) AS total_kasbon,
    COALESCE(sum(
        CASE
            WHEN (eam.movement_type = 'pemakaian'::text) THEN eam.amount
            ELSE (0)::numeric
        END), (0)::numeric) AS total_pemakaian,
    COALESCE(sum(
        CASE
            WHEN (eam.movement_type = 'pengembalian'::text) THEN eam.amount
            ELSE (0)::numeric
        END), (0)::numeric) AS total_pengembalian,
    count(eam.id) AS movement_count
   FROM (public.employee_advance ea
     LEFT JOIN public.employee_advance_movements eam ON ((ea.employee_id = eam.employee_id)))
  GROUP BY ea.employee_id, ea.employee_name, ea.balance;


ALTER VIEW public.vw_employee_advance_summary OWNER TO postgres;

--
-- Name: vw_journal_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_journal_summary AS
 SELECT id,
    journal_ref,
    transaction_date,
    account_code,
    account_name,
    debit,
    credit,
    description,
    created_at
   FROM public.journal_entries je
  ORDER BY transaction_date DESC, created_at DESC;


ALTER VIEW public.vw_journal_summary OWNER TO postgres;

--
-- Name: vw_loan_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_loan_summary AS
 SELECT id,
    created_at,
    updated_at,
    loan_date,
    loan_number,
    lender_name,
    lender_type,
    principal_amount,
    interest_rate,
    loan_term_months,
    payment_schedule,
    maturity_date,
    total_paid,
    total_interest_paid,
    remaining_balance,
    status,
    coa_cash_code,
    coa_loan_code,
    coa_interest_code,
    purpose,
    notes,
    journal_ref,
    payment_history,
    (principal_amount - COALESCE(total_paid, (0)::numeric)) AS sisa_pokok,
        CASE
            WHEN (status = 'Lunas'::text) THEN 'Sudah Lunas'::text
            WHEN (remaining_balance > (0)::numeric) THEN ('Sisa: Rp '::text || to_char(remaining_balance, 'FM999,999,999,999'::text))
            ELSE 'Lunas'::text
        END AS status_pembayaran,
    jsonb_array_length(COALESCE(payment_history, '[]'::jsonb)) AS jumlah_pembayaran,
    ( SELECT sum(((p.value ->> 'principal_amount'::text))::numeric) AS sum
           FROM jsonb_array_elements(l.payment_history) p(value)) AS total_principal_dibayar,
    ( SELECT sum(((p.value ->> 'interest_amount'::text))::numeric) AS sum
           FROM jsonb_array_elements(l.payment_history) p(value)) AS total_bunga_dibayar
   FROM public.loans l;


ALTER VIEW public.vw_loan_summary OWNER TO postgres;

--
-- Name: vw_purchase_requests; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_purchase_requests AS
 SELECT (created_at)::date AS request_date,
    name,
    request_code,
    item_name,
    total_amount,
    status
   FROM public.purchase_requests pr;


ALTER VIEW public.vw_purchase_requests OWNER TO postgres;

--
-- Name: vw_stock_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_stock_summary AS
 SELECT id,
    sku,
    item_name,
    quantity,
    unit,
    COALESCE(average_cost, (0)::numeric) AS average_cost,
    COALESCE(total_value, (0)::numeric) AS total_value,
    COALESCE(selling_price, (0)::numeric) AS selling_price,
    (COALESCE(selling_price, (0)::numeric) - COALESCE(average_cost, (0)::numeric)) AS margin,
        CASE
            WHEN (COALESCE(average_cost, (0)::numeric) > (0)::numeric) THEN round((((COALESCE(selling_price, (0)::numeric) - COALESCE(average_cost, (0)::numeric)) / average_cost) * (100)::numeric), 2)
            ELSE (0)::numeric
        END AS margin_percent
   FROM public.stock s
  ORDER BY item_name;


ALTER VIEW public.vw_stock_summary OWNER TO postgres;

--
-- Name: vw_transaction_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_transaction_summary AS
 SELECT id,
    transaction_number,
    transaction_type,
    transaction_date,
    description,
    total_amount,
    status,
    customer_name,
    vendor_name,
    employee_name,
    payment_method,
    ppn_amount,
    pph_amount,
    created_at
   FROM public.transactions t
  ORDER BY transaction_date DESC, created_at DESC;


ALTER VIEW public.vw_transaction_summary OWNER TO postgres;

