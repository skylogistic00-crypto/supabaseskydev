-- Name: generate_advance_number(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_advance_number() RETURNS text
    LANGUAGE plpgsql
    AS $$
DECLARE
  next_num INTEGER;
  year_month TEXT;
BEGIN
  year_month := TO_CHAR(CURRENT_DATE, 'YYYYMM');
  
  SELECT COALESCE(MAX(CAST(SUBSTRING(advance_number FROM 10) AS INTEGER)), 0) + 1
  INTO next_num
  FROM employee_advances
  WHERE advance_number LIKE 'ADV-' || year_month || '%';
  
  RETURN 'ADV-' || year_month || '-' || LPAD(next_num::TEXT, 4, '0');
END;
$$;


