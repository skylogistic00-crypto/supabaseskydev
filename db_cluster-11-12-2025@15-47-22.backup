--
-- Name: update_stock_on_purchase_update(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_stock_on_purchase_update() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
begin
  -- Kurangi quantity lama
  update stock
  set quantity = quantity - old.quantity
  where id = old.item_id;

  -- Tambahkan quantity baru
  update stock
  set quantity = quantity + new.quantity
  where id = new.item_id;

  return new;
end;
$$;


