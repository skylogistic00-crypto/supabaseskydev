-- Name: users Delete users; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Delete users" ON public.users FOR DELETE TO authenticated USING ((( SELECT users_1.role_id
   FROM public.users users_1
  WHERE (users_1.id = auth.uid())) = 1));


--
-- Name: drivers Drivers admin full; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Drivers admin full" ON public.drivers USING ((EXISTS ( SELECT 1
   FROM auth.users au
  WHERE ((au.id = auth.uid()) AND ((au.raw_user_meta_data ->> 'role'::text) = 'admin'::text)))));


