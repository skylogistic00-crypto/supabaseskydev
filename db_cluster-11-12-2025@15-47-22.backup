--
-- Name: stock_movement; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.stock_movement (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    item_id uuid NOT NULL,
    from_line text,
    to_line text,
    movement_type text NOT NULL,
    qty numeric NOT NULL,
    cost_per_unit numeric,
    total_value numeric GENERATED ALWAYS AS ((qty * cost_per_unit)) STORED,
    reference_no text,
    movement_date timestamp without time zone DEFAULT now(),
    remarks text,
    created_at timestamp without time zone DEFAULT now(),
    movement_at timestamp with time zone DEFAULT now() NOT NULL,
    from_location_id uuid,
    to_location_id uuid,
    unit_cost numeric(18,6),
    CONSTRAINT stock_movement_move_logic_check CHECK ((((movement_type = 'in'::text) AND (to_location_id IS NOT NULL) AND (from_location_id IS NULL)) OR ((movement_type = 'out'::text) AND (from_location_id IS NOT NULL) AND (to_location_id IS NULL)) OR ((movement_type = 'transfer'::text) AND (from_location_id IS NOT NULL) AND (to_location_id IS NOT NULL) AND (from_location_id <> to_location_id)))),
    CONSTRAINT stock_movement_movement_type_check CHECK ((movement_type = ANY (ARRAY['RECEIVE'::text, 'ISSUE'::text, 'TRANSFER'::text, 'RETURN'::text, 'ADJUSTMENT'::text]))),
    CONSTRAINT stock_movement_type_check CHECK ((movement_type = ANY (ARRAY['in'::text, 'out'::text, 'transfer'::text])))
);


ALTER TABLE public.stock_movement OWNER TO postgres;

