--
-- Name: trg_update_coa_balance(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.trg_update_coa_balance() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  acct text;
BEGIN
  -- Tentukan akun yg terpengaruh
  IF TG_OP = 'DELETE' THEN
    acct := OLD.account_code;
  ELSE
    acct := NEW.account_code;
  END IF;

  -- Hanya update jika account_code ada di COA
  UPDATE chart_of_accounts coa
  SET balance = COALESCE((
    SELECT 
      CASE 
        WHEN UPPER(coa.normal_balance) IN ('DEBIT','D') 
          THEN COALESCE(SUM(gl.debit),0) 
        WHEN UPPER(coa.normal_balance) IN ('CREDIT','K') 
          THEN COALESCE(SUM(gl.credit),0) 
        ELSE 
          COALESCE(SUM(gl.debit),0) - COALESCE(SUM(gl.credit),0)
      END
    FROM general_ledger gl
    WHERE gl.account_code = acct
  ), 0)
  WHERE coa.account_code = acct;  -- hanya update jika match

  RETURN NULL;
END;
$$;


ALTER FUNCTION public.trg_update_coa_balance() OWNER TO postgres;

--
-- Name: trial_balance(date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.trial_balance(report_date date) RETURNS TABLE(account_code text, account_name text, debit numeric, credit numeric, balance numeric)
    LANGUAGE sql STABLE
    AS $$
    SELECT
        coa.account_code,
        coa.account_name,
        SUM(gl.debit) AS debit,
        SUM(gl.credit) AS credit,
        SUM(gl.debit - gl.credit) AS balance
    FROM general_ledger gl
    JOIN journal_entries je ON je.id = gl.journal_id
    JOIN chart_of_accounts coa ON coa.account_code = gl.account_code
    WHERE je.transaction_date <= report_date
    GROUP BY coa.account_code, coa.account_name
    ORDER BY coa.account_code;
$$;


ALTER FUNCTION public.trial_balance(report_date date) OWNER TO postgres;

--
-- Name: update_advance_balance(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_advance_balance() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  total_settled NUMERIC(15,2);
  total_returned NUMERIC(15,2);
  advance_amount NUMERIC(15,2);
  new_balance NUMERIC(15,2);
  new_status TEXT;
BEGIN
  -- Get advance amount
  SELECT amount INTO advance_amount
  FROM employee_advances
  WHERE id = COALESCE(NEW.advance_id, OLD.advance_id);
  
  -- Calculate total settled
  SELECT COALESCE(SUM(total), 0) INTO total_settled
  FROM employee_advance_settlements
  WHERE advance_id = COALESCE(NEW.advance_id, OLD.advance_id);
  
  -- Calculate total returned
  SELECT COALESCE(SUM(amount), 0) INTO total_returned
  FROM employee_advance_returns
  WHERE advance_id = COALESCE(NEW.advance_id, OLD.advance_id);
  
  -- Calculate new balance
  new_balance := advance_amount - total_settled - total_returned;
  
  -- Determine new status
  IF new_balance = 0 THEN
    new_status := 'settled';
  ELSIF new_balance < advance_amount THEN
    new_status := 'partially_settled';
  ELSE
    new_status := 'pending';
  END IF;
  
  -- Update advance record
  UPDATE employee_advances
  SET 
    remaining_balance = new_balance,
    status = new_status,
    updated_at = NOW()
  WHERE id = COALESCE(NEW.advance_id, OLD.advance_id);
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.update_advance_balance() OWNER TO postgres;

