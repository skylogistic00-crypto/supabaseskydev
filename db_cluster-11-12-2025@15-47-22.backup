--
-- Name: payroll; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.payroll (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    employee_id uuid,
    period_month integer NOT NULL,
    period_year integer NOT NULL,
    basic_salary numeric(15,2) NOT NULL,
    transport_allowance numeric(15,2) DEFAULT 0,
    meal_allowance numeric(15,2) DEFAULT 0,
    position_allowance numeric(15,2) DEFAULT 0,
    other_allowances jsonb,
    overtime_hours numeric(5,2) DEFAULT 0,
    overtime_pay numeric(15,2) DEFAULT 0,
    late_deduction numeric(15,2) DEFAULT 0,
    absence_deduction numeric(15,2) DEFAULT 0,
    loan_deduction numeric(15,2) DEFAULT 0,
    bpjs_kesehatan_deduction numeric(15,2) DEFAULT 0,
    bpjs_ketenagakerjaan_deduction numeric(15,2) DEFAULT 0,
    other_deductions jsonb,
    tax_pph21 numeric(15,2) DEFAULT 0,
    gross_salary numeric(15,2) NOT NULL,
    total_deductions numeric(15,2) NOT NULL,
    net_salary numeric(15,2) NOT NULL,
    payment_date date,
    payment_method text,
    payment_status text DEFAULT 'pending'::text,
    notes text,
    slip_file_url text,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    CONSTRAINT payroll_payment_method_check CHECK ((payment_method = ANY (ARRAY['transfer'::text, 'cash'::text, 'check'::text]))),
    CONSTRAINT payroll_payment_status_check CHECK ((payment_status = ANY (ARRAY['pending'::text, 'paid'::text, 'cancelled'::text]))),
    CONSTRAINT payroll_period_month_check CHECK (((period_month >= 1) AND (period_month <= 12)))
);


ALTER TABLE public.payroll OWNER TO postgres;

