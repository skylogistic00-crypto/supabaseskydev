--
-- Name: tb_sync_from_gl(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.tb_sync_from_gl() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
    v_old_ac text;
    v_new_ac text;
    v_old_debit numeric := 0;
    v_old_credit numeric := 0;
    v_new_debit numeric := 0;
    v_new_credit numeric := 0;
    v_name text;
    d_delta numeric := 0;
    c_delta numeric := 0;
BEGIN
    -- normalisasi account_code menggunakan trim
    IF TG_OP = 'INSERT' THEN
        v_new_ac := trim(COALESCE(NEW.account_code::text, ''));
        v_new_debit := COALESCE(NEW.debit,0);
        v_new_credit := COALESCE(NEW.credit,0);

        IF v_new_ac = '' THEN
            RETURN NEW;
        END IF;

        -- upsert: masukkan nilai debit/credit awal (atau tambahkan jika sudah ada)
        INSERT INTO trial_balance (
            account_code, account_name, total_debit, total_credit, updated_at
        )
        VALUES (
            v_new_ac,
            (SELECT account_name FROM chart_of_accounts WHERE trim(account_code)=v_new_ac LIMIT 1),
            v_new_debit,
            v_new_credit,
            now()
        )
        ON CONFLICT (account_code) DO UPDATE
        SET total_debit  = COALESCE(trial_balance.total_debit,0) + EXCLUDED.total_debit,
            total_credit = COALESCE(trial_balance.total_credit,0) + EXCLUDED.total_credit,
            account_name  = COALESCE(EXCLUDED.account_name, trial_balance.account_name),
            updated_at    = now();

        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN
        v_old_ac := trim(COALESCE(OLD.account_code::text,''));
        IF v_old_ac = '' THEN
            RETURN OLD;
        END IF;

        v_old_debit := COALESCE(OLD.debit,0);
        v_old_credit := COALESCE(OLD.credit,0);

        UPDATE trial_balance
        SET total_debit  = COALESCE(total_debit,0),
            total_credit = COALESCE(total_credit,0),
            updated_at    = now()
        WHERE account_code = v_old_ac;

        RETURN OLD;

    ELSIF TG_OP = 'UPDATE' THEN
        v_old_ac := trim(COALESCE(OLD.account_code::text,''));
        v_new_ac := trim(COALESCE(NEW.account_code::text,''));
        v_old_debit := COALESCE(OLD.debit,0);
        v_old_credit := COALESCE(OLD.credit,0);
        v_new_debit := COALESCE(NEW.debit,0);
        v_new_credit := COALESCE(NEW.credit,0);

        d_delta := v_new_debit - v_old_debit;
        c_delta := v_new_credit - v_old_credit;

        -- Jika account_code berubah: subtract nilai lama dari akun lama
        IF v_old_ac <> '' AND v_old_ac IS DISTINCT FROM v_new_ac THEN
            UPDATE trial_balance
            SET total_debit  = COALESCE(total_debit,0),
                total_credit = COALESCE(total_credit,0),
                updated_at    = now()
            WHERE account_code = v_old_ac;
        END IF;

        -- Jika account tetap sama: apply delta (penyesuaian)
        IF v_new_ac <> '' AND v_new_ac = v_old_ac THEN
            UPDATE trial_balance
            SET total_debit  = COALESCE(total_debit,0) + d_delta,
                total_credit = COALESCE(total_credit,0) + c_delta,
                updated_at    = now()
            WHERE account_code = v_new_ac;
        END IF;

        -- Jika account baru (atau account berubah ke akun berbeda), tambahkan/ upsert ke akun baru
        IF v_new_ac <> '' THEN
            INSERT INTO trial_balance (
                account_code, account_name, total_debit, total_credit, updated_at
            )
            VALUES (
                v_new_ac,
                (SELECT account_name FROM chart_of_accounts WHERE trim(account_code)=v_new_ac LIMIT 1),
                v_new_debit,
                v_new_credit,
                now()
            )
            ON CONFLICT (account_code) DO UPDATE
            SET total_debit  = COALESCE(trial_balance.total_debit,0) + EXCLUDED.total_debit,
                total_credit = COALESCE(trial_balance.total_credit,0) + EXCLUDED.total_credit,
                account_name  = COALESCE(EXCLUDED.account_name, trial_balance.account_name),
                updated_at    = now();
        END IF;

        RETURN NEW;
    END IF;

    RETURN NULL;
END;
$$;


ALTER FUNCTION public.tb_sync_from_gl() OWNER TO postgres;

