--
-- Name: generate_journal(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_journal(disbursement_id uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
  cd RECORD;
  coa_cash RECORD;
  coa_expense RECORD;
BEGIN
  -- Ambil data transaksinya
  SELECT *
  INTO cd
  FROM cash_disbursement
  WHERE id = disbursement_id;

  IF cd IS NULL THEN
    RAISE EXCEPTION 'Transaksi tidak ditemukan';
  END IF;

  -- Ambil COA Kas/Bank
  SELECT *
  INTO coa_cash
  FROM chart_of_accounts
  WHERE id = cd.coa_cash_id;

  IF coa_cash IS NULL THEN
    RAISE EXCEPTION 'COA Kas/Bank tidak ditemukan';
  END IF;

  -- Ambil COA Beban
  SELECT *
  INTO coa_expense
  FROM chart_of_accounts
  WHERE id = cd.coa_expense_id;

  IF coa_expense IS NULL THEN
    RAISE EXCEPTION 'COA Beban tidak ditemukan';
  END IF;

  -- INSERT JURNAL: DEBIT BEBAN
  INSERT INTO journal_entries (
      disbursement_id,
      account_id,
      account_code,
      account_name,
      account_type,
      debit,
      credit,
      description,
      transaction_date,
      created_at
  )
  VALUES (
      cd.id,
      coa_expense.id,
      coa_expense.account_code,
      coa_expense.account_name,
      coa_expense.account_type,
      cd.amount,
      0,
      cd.description,
      cd.transaction_date,
      NOW()
  );

  -- INSERT JURNAL: KREDIT KAS/BANK
  INSERT INTO journal_entries (
      disbursement_id,
      account_id,
      account_code,
      account_name,
      account_type,
      debit,
      credit,
      description,
      transaction_date,
      created_at
  )
  VALUES (
      cd.id,
      coa_cash.id,
      coa_cash.account_code,
      coa_cash.account_name,
      coa_cash.account_type,
      0,
      cd.amount,
      cd.description,
      cd.transaction_date,
      NOW()
  );

END;
$$;


ALTER FUNCTION public.generate_journal(disbursement_id uuid) OWNER TO postgres;

