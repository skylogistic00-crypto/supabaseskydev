--
-- Name: auto_journal_booking(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.auto_journal_booking() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
    response jsonb;
BEGIN
    -- Call auto-journal Edge Function
    SELECT net.http_post(
        url := CONCAT(current_setting('app.settings.functions_url'), '/auto-journal'),
        headers := jsonb_build_object(
            'Content-Type','application/json',
            'Authorization', CONCAT('Bearer ', current_setting('app.settings.service_role_key'))
        ),
        body := jsonb_build_object(
            'amount', NEW.total,
            'description', CONCAT('Booking ', NEW.facility, ' Ref: ', NEW.booking_reference),
            'transaction_type', 'booking',
            'service_category', NEW.facility,
            'payment_method', NEW.payment_method
        )
    )::jsonb INTO response;

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.auto_journal_booking() OWNER TO postgres;

