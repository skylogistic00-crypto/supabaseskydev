-- Name: loans; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.loans (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    loan_date date NOT NULL,
    loan_number text,
    lender_name text NOT NULL,
    lender_type text,
    principal_amount numeric(15,2) NOT NULL,
    interest_rate numeric(5,2) DEFAULT 0,
    loan_term_months integer,
    payment_schedule text,
    maturity_date date,
    total_paid numeric(15,2) DEFAULT 0,
    total_interest_paid numeric(15,2) DEFAULT 0,
    remaining_balance numeric(15,2),
    status text DEFAULT 'Aktif'::text,
    coa_cash_code text NOT NULL,
    coa_loan_code text NOT NULL,
    coa_interest_code text,
    purpose text,
    notes text,
    journal_ref text,
    payment_history jsonb DEFAULT '[]'::jsonb,
    borrower_id uuid,
    late_fee_percentage numeric(5,2) DEFAULT 0.1,
    late_fee_per_day numeric(5,2) DEFAULT 0.1,
    tax_type character varying(50),
    tax_percentage numeric(5,2) DEFAULT 0,
    tax_amount numeric(15,2) DEFAULT 0,
    CONSTRAINT loans_lender_type_check CHECK ((lender_type = ANY (ARRAY['Bank'::text, 'Individu'::text, 'Perusahaan'::text, 'Lainnya'::text]))),
    CONSTRAINT loans_payment_schedule_check CHECK ((payment_schedule = ANY (ARRAY['Bulanan'::text, 'Triwulan'::text, 'Tahunan'::text, 'Jatuh Tempo'::text]))),
    CONSTRAINT loans_status_check CHECK ((status = ANY (ARRAY['Aktif'::text, 'Lunas'::text, 'Jatuh Tempo'::text, 'Menunggak'::text])))
);


ALTER TABLE public.loans OWNER TO postgres;

