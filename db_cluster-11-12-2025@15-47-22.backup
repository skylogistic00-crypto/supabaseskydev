--
-- Name: process_bank_mutation(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.process_bank_mutation() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
    response jsonb;
BEGIN
    -- Call Edge Function auto-journal
    SELECT
        net.http_post(
            url := CONCAT(current_setting('app.settings.functions_url'), '/auto-journal'),
            headers := jsonb_build_object(
                'Content-Type', 'application/json',
                'Authorization', CONCAT('Bearer ', current_setting('app.settings.service_role_key'))
            ),
            body := jsonb_build_object(
                'amount', NEW.amount,
                'description', NEW.description,
                'payment_method', NEW.bank_name,
                'va_prefix', NEW.va_prefix,
                'ref_prefix', NEW.ref_prefix,
                'transaction_type', 'bank_mutation'
            )
        )::jsonb INTO response;

    -- Mark as processed
    UPDATE bank_mutations
    SET processed = true
    WHERE id = NEW.id;

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.process_bank_mutation() OWNER TO postgres;

--
-- Name: rebuild_general_ledger(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.rebuild_general_ledger() RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
  DELETE FROM public.general_ledger;

  INSERT INTO public.general_ledger
    (id, journal_entry_id, journal_item_id, account_code, "date",
     description, debit, credit, created_at, updated_at)
  SELECT
    gen_random_uuid(),
    j.id AS journal_entry_id,
    i.id AS journal_item_id,
    c.account_code,
    j."date",
    COALESCE(i.description, j.description),
    COALESCE(i.debit, 0),
    COALESCE(i.credit, 0),
    now(), now()
  FROM public.journal_entry_items i
  JOIN public.journal_entries j ON j.id = i.journal_entry_id
  JOIN public.chart_of_accounts c ON c.id = i.account_id;  -- mapping akun
END;
$$;


ALTER FUNCTION public.rebuild_general_ledger() OWNER TO postgres;

--
-- Name: recalc_journal_totals(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.recalc_journal_totals(p_je_id uuid) RETURNS void
    LANGUAGE sql
    AS $$
  WITH s AS (
    SELECT
      COALESCE(SUM(debit), 0)::numeric(18,2)  AS sum_debit,
      COALESCE(SUM(credit), 0)::numeric(18,2) AS sum_credit
    FROM public.journal_entry_items
    WHERE journal_entry_id = p_je_id
  )
  UPDATE public.journal_entries e
  SET total_debit = s.sum_debit,
      total_credit = s.sum_credit,
      debit = s.sum_debit,          -- kalau kolom ini ingin mirror total
      credit = s.sum_credit,
      updated_at = now()
  FROM s
  WHERE e.id = p_je_id;
$$;


ALTER FUNCTION public.recalc_journal_totals(p_je_id uuid) OWNER TO postgres;

--
-- Name: recalc_trial_balance_period(date, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.recalc_trial_balance_period(p_period_start date, p_account_code text DEFAULT NULL::text) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_start date := date_trunc('month', p_period_start)::date;
  v_end   date := (date_trunc('month', p_period_start) + interval '1 month - 1 day')::date;
BEGIN
  -- Hitung OPENING (sampai H-1 v_start) dan aktivitas periode (v_start..v_end)
  WITH
  opening AS (
    SELECT account_code, COALESCE(SUM(amount_signed),0)::numeric AS opening_balance
    FROM public.general_ledger gl
    WHERE gl.posting_date < v_start
      AND (p_account_code IS NULL OR gl.account_code = p_account_code)
      AND gl.account_code IS NOT NULL
    GROUP BY account_code
  ),
  activity AS (
    SELECT account_code,
           COALESCE(SUM(debit),0)::numeric  AS debit,
           COALESCE(SUM(credit),0)::numeric AS credit
    FROM public.general_ledger gl
    WHERE gl.posting_date BETWEEN v_start AND v_end
      AND (p_account_code IS NULL OR gl.account_code = p_account_code)
      AND gl.account_code IS NOT NULL
    GROUP BY account_code
  ),
  codes AS (
    -- Semua akun yang punya opening ATAU aktivitas periode
    SELECT account_code FROM opening
    UNION
    SELECT account_code FROM activity
  ),
  merged AS (
    SELECT
      c.account_code,
      COALESCE(o.opening_balance,0) AS opening_balance,
      COALESCE(a.debit,0)           AS debit,
      COALESCE(a.credit,0)          AS credit
    FROM codes c
    LEFT JOIN opening o USING (account_code)
    LEFT JOIN activity a USING (account_code)
  )
  INSERT INTO public.trial_balance (
    period_start, period_end, account_code,
    opening_balance, debit, credit, closing_balance,
    created_at, updated_at
  )
  SELECT
    v_start, v_end, m.account_code,
    m.opening_balance,
    m.debit, m.credit,
    (m.opening_balance + m.debit - m.credit) AS closing_balance,
    now(), now()
  FROM merged m
  ON CONFLICT (period_start, account_code)
  DO UPDATE SET
    period_end       = EXCLUDED.period_end,
    opening_balance  = EXCLUDED.opening_balance,
    debit            = EXCLUDED.debit,
    credit           = EXCLUDED.credit,
    closing_balance  = EXCLUDED.closing_balance,
    updated_at       = now();

  -- (Opsional) bersihkan baris nol total untuk periode & akun yang tidak punya apa-apa
  DELETE FROM public.trial_balance tb
  WHERE tb.period_start = v_start
    AND (p_account_code IS NULL OR tb.account_code = p_account_code)
    AND tb.opening_balance = 0 AND tb.debit = 0 AND tb.credit = 0 AND tb.closing_balance = 0;
END;
$$;


ALTER FUNCTION public.recalc_trial_balance_period(p_period_start date, p_account_code text) OWNER TO postgres;

--
-- Name: recalculate_all_coa_balances(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.recalculate_all_coa_balances() RETURNS void
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- Reset all balances to 0
  UPDATE chart_of_accounts
  SET 
    debit = 0,
    credit = 0,
    current_balance = 0;

  -- Recalculate from journal_entries
  UPDATE chart_of_accounts coa
  SET 
    debit = COALESCE(je_totals.total_debit, 0),
    credit = COALESCE(je_totals.total_credit, 0),
    current_balance = ABS(COALESCE(je_totals.total_debit, 0) - COALESCE(je_totals.total_credit, 0)),
    updated_at = NOW()
  FROM (
    SELECT 
      account_code,
      SUM(debit) as total_debit,
      SUM(credit) as total_credit
    FROM journal_entries
    GROUP BY account_code
  ) je_totals
  WHERE coa.account_code = je_totals.account_code;

  RAISE NOTICE 'All COA balances have been recalculated';
END;
$$;


ALTER FUNCTION public.recalculate_all_coa_balances() OWNER TO postgres;

