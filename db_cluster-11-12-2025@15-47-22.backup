--
-- Name: get_general_ledger(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_general_ledger(p_account_code text) RETURNS TABLE(journal_date date, journal_ref text, description text, debit numeric, credit numeric, balance numeric)
    LANGUAGE sql
    AS $$
    SELECT 
        je.journal_date,
        COALESCE(je.journal_number, substring(je.id::text,1,8)) AS journal_ref,
        jel.description,
        jel.debit,
        jel.credit,
        SUM(jel.debit - jel.credit) OVER (ORDER BY je.journal_date, COALESCE(je.journal_number, je.id::text)) AS balance
    FROM public.journal_entry_lines jel
    JOIN public.journal_entries je ON jel.journal_id = je.id
    WHERE jel.account_code = p_account_code
    ORDER BY je.journal_date, COALESCE(je.journal_number, je.id::text);
$$;


ALTER FUNCTION public.get_general_ledger(p_account_code text) OWNER TO postgres;

--
-- Name: get_hari_di_gudang(date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_hari_di_gudang(tanggal_masuk date) RETURNS integer
    LANGUAGE plpgsql IMMUTABLE
    AS $$
BEGIN
  IF tanggal_masuk IS NULL THEN
    RETURN NULL;
  END IF;
  RETURN EXTRACT(DAY FROM (CURRENT_DATE - tanggal_masuk))::INTEGER;
END;
$$;


ALTER FUNCTION public.get_hari_di_gudang(tanggal_masuk date) OWNER TO postgres;

