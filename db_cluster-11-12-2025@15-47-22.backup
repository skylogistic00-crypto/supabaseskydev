-- Name: vehicle_rentals; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.vehicle_rentals (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    rental_number character varying(50) NOT NULL,
    vehicle_id uuid,
    customer_id uuid,
    user_id uuid,
    start_date date NOT NULL,
    end_date date NOT NULL,
    pickup_time time without time zone,
    return_time time without time zone,
    pickup_location text,
    return_location text,
    rental_type character varying(20) DEFAULT 'daily'::character varying,
    base_price numeric(12,2) NOT NULL,
    additional_charges numeric(12,2) DEFAULT 0,
    discount numeric(12,2) DEFAULT 0,
    total_amount numeric(12,2) NOT NULL,
    deposit_amount numeric(12,2) DEFAULT 0,
    status character varying(20) DEFAULT 'pending'::character varying,
    payment_status character varying(20) DEFAULT 'pending'::character varying,
    odometer_start integer,
    odometer_end integer,
    fuel_level_start character varying(20),
    fuel_level_end character varying(20),
    notes text,
    created_by uuid,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    CONSTRAINT vehicle_rentals_payment_status_check CHECK (((payment_status)::text = ANY (ARRAY[('pending'::character varying)::text, ('partial'::character varying)::text, ('paid'::character varying)::text, ('refunded'::character varying)::text]))),
    CONSTRAINT vehicle_rentals_rental_type_check CHECK (((rental_type)::text = ANY (ARRAY[('daily'::character varying)::text, ('weekly'::character varying)::text, ('monthly'::character varying)::text]))),
    CONSTRAINT vehicle_rentals_status_check CHECK (((status)::text = ANY (ARRAY[('pending'::character varying)::text, ('confirmed'::character varying)::text, ('active'::character varying)::text, ('completed'::character varying)::text, ('cancelled'::character varying)::text])))
);


ALTER TABLE public.vehicle_rentals OWNER TO postgres;

