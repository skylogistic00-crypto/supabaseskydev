--
-- Name: get_trial_balance(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_trial_balance() RETURNS TABLE(account_code text, account_name text, total_debit numeric, total_credit numeric, balance numeric)
    LANGUAGE sql
    AS $$
    SELECT
        account_code,
        MIN(account_name) AS account_name,
        COALESCE(SUM(debit),0) AS total_debit,
        COALESCE(SUM(credit),0) AS total_credit,
        COALESCE(SUM(debit - credit),0) AS balance
    FROM public.journal_entry_lines
    GROUP BY account_code
    ORDER BY account_code;
$$;


