--
-- Name: cash_disbursement; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.cash_disbursement (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    transaction_date date NOT NULL,
    document_number text,
    payment_method text NOT NULL,
    bank_account text,
    payee_name text NOT NULL,
    description text NOT NULL,
    category text,
    amount numeric(15,2) NOT NULL,
    attachment_url text,
    approval_status text DEFAULT 'waiting_approval'::text,
    approved_by uuid,
    approved_at timestamp with time zone,
    rejection_reason text,
    journal_ref text,
    notes text,
    created_by uuid,
    bukti text,
    account_code character varying(20),
    status text DEFAULT 'draft'::text,
    evidence_url text,
    cost_center_id uuid,
    tax_amount numeric(18,2) DEFAULT 0,
    tax_type text,
    tax_code text,
    currency_code character varying(10) DEFAULT 'IDR'::character varying,
    exchange_rate numeric(18,6) DEFAULT 1,
    normalized_amount numeric(18,2),
    ocr_data jsonb,
    coa_id uuid,
    account_name text,
    ocr_id text,
    bank_account_id uuid,
    cash_account_id uuid,
    coa_cash_id uuid,
    coa_expense_id uuid,
    coa_cash_account_code text,
    coa_expense_account_code text,
    CONSTRAINT cash_disbursement_amount_check CHECK ((amount > (0)::numeric)),
    CONSTRAINT cash_disbursement_approval_status_check CHECK ((approval_status = ANY (ARRAY['waiting_approval'::text, 'approved'::text, 'rejected'::text]))),
    CONSTRAINT cash_disbursement_status_check CHECK ((status = ANY (ARRAY['draft'::text, 'approved'::text, 'posted'::text]))),
    CONSTRAINT cashd_amount_positive CHECK ((amount >= (0)::numeric)),
    CONSTRAINT cashd_exchange_rate_positive CHECK ((exchange_rate > (0)::numeric))
);


ALTER TABLE public.cash_disbursement OWNER TO postgres;

