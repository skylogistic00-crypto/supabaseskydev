--
-- Name: update_coa_balance_from_journal(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_coa_balance_from_journal() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_account_code TEXT;
  v_debit_amount NUMERIC(15,2);
  v_credit_amount NUMERIC(15,2);
BEGIN
  -- Determine if this is INSERT, UPDATE, or DELETE
  IF TG_OP = 'DELETE' THEN
    v_account_code := OLD.account_code;
    v_debit_amount := -OLD.debit;
    v_credit_amount := -OLD.credit;
  ELSIF TG_OP = 'UPDATE' THEN
    v_account_code := NEW.account_code;
    -- Calculate the difference
    v_debit_amount := NEW.debit - OLD.debit;
    v_credit_amount := NEW.credit - OLD.credit;
  ELSE -- INSERT
    v_account_code := NEW.account_code;
    v_debit_amount := NEW.debit;
    v_credit_amount := NEW.credit;
  END IF;

  -- Update the chart_of_accounts
  UPDATE chart_of_accounts
  SET 
    debit = COALESCE(debit, 0) + v_debit_amount,
    credit = COALESCE(credit, 0) + v_credit_amount,
    current_balance = ABS(COALESCE(debit, 0) + v_debit_amount - (COALESCE(credit, 0) + v_credit_amount)),
    updated_at = NOW()
  WHERE account_code = v_account_code;

  -- If account doesn't exist, log a warning (optional)
  IF NOT FOUND THEN
    RAISE WARNING 'Account code % not found in chart_of_accounts', v_account_code;
  END IF;

  IF TG_OP = 'DELETE' THEN
    RETURN OLD;
  ELSE
    RETURN NEW;
  END IF;
END;
$$;


ALTER FUNCTION public.update_coa_balance_from_journal() OWNER TO postgres;

