     OR (COALESCE(NEW.description,'') IS DISTINCT FROM COALESCE(OLD.description,''))
     OR (COALESCE(NEW.account_number,'') IS DISTINCT FROM COALESCE(OLD.account_number,'')) THEN
    PERFORM public.repost_gl_for_journal_entry(NEW.id);
