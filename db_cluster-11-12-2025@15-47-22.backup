--
-- Name: grant_pg_cron_access(); Type: FUNCTION; Schema: extensions; Owner: supabase_admin
--

CREATE FUNCTION extensions.grant_pg_cron_access() RETURNS event_trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF EXISTS (
    SELECT
    FROM pg_event_trigger_ddl_commands() AS ev
    JOIN pg_extension AS ext
    ON ev.objid = ext.oid
    WHERE ext.extname = 'pg_cron'
  )
  THEN
    grant usage on schema cron to postgres with grant option;

    alter default privileges in schema cron grant all on tables to postgres with grant option;
    alter default privileges in schema cron grant all on functions to postgres with grant option;
    alter default privileges in schema cron grant all on sequences to postgres with grant option;

    alter default privileges for user supabase_admin in schema cron grant all
        on sequences to postgres with grant option;
    alter default privileges for user supabase_admin in schema cron grant all
        on tables to postgres with grant option;
    alter default privileges for user supabase_admin in schema cron grant all
        on functions to postgres with grant option;

    grant all privileges on all tables in schema cron to postgres with grant option;
    revoke all on table cron.job from postgres;
    grant select on table cron.job to postgres with grant option;
  END IF;
END;
$$;


ALTER FUNCTION extensions.grant_pg_cron_access() OWNER TO supabase_admin;

--
-- Name: FUNCTION grant_pg_cron_access(); Type: COMMENT; Schema: extensions; Owner: supabase_admin
--

COMMENT ON FUNCTION extensions.grant_pg_cron_access() IS 'Grants access to pg_cron';


--
-- Name: grant_pg_graphql_access(); Type: FUNCTION; Schema: extensions; Owner: supabase_admin
--

CREATE FUNCTION extensions.grant_pg_graphql_access() RETURNS event_trigger
    LANGUAGE plpgsql
    AS $_$
DECLARE
    func_is_graphql_resolve bool;
BEGIN
    func_is_graphql_resolve = (
        SELECT n.proname = 'resolve'
        FROM pg_event_trigger_ddl_commands() AS ev
        LEFT JOIN pg_catalog.pg_proc AS n
        ON ev.objid = n.oid
    );

    IF func_is_graphql_resolve
    THEN
        -- Update public wrapper to pass all arguments through to the pg_graphql resolve func
        DROP FUNCTION IF EXISTS graphql_public.graphql;
        create or replace function graphql_public.graphql(
            "operationName" text default null,
            query text default null,
            variables jsonb default null,
            extensions jsonb default null
        )
            returns jsonb
            language sql
        as $$
            select graphql.resolve(
                query := query,
                variables := coalesce(variables, '{}'),
                "operationName" := "operationName",
                extensions := extensions
            );
        $$;

        -- This hook executes when `graphql.resolve` is created. That is not necessarily the last
        -- function in the extension so we need to grant permissions on existing entities AND
        -- update default permissions to any others that are created after `graphql.resolve`
        grant usage on schema graphql to postgres, anon, authenticated, service_role;
        grant select on all tables in schema graphql to postgres, anon, authenticated, service_role;
        grant execute on all functions in schema graphql to postgres, anon, authenticated, service_role;
        grant all on all sequences in schema graphql to postgres, anon, authenticated, service_role;
        alter default privileges in schema graphql grant all on tables to postgres, anon, authenticated, service_role;
        alter default privileges in schema graphql grant all on functions to postgres, anon, authenticated, service_role;
        alter default privileges in schema graphql grant all on sequences to postgres, anon, authenticated, service_role;

        -- Allow postgres role to allow granting usage on graphql and graphql_public schemas to custom roles
        grant usage on schema graphql_public to postgres with grant option;
        grant usage on schema graphql to postgres with grant option;
    END IF;

END;
$_$;


ALTER FUNCTION extensions.grant_pg_graphql_access() OWNER TO supabase_admin;

--
-- Name: FUNCTION grant_pg_graphql_access(); Type: COMMENT; Schema: extensions; Owner: supabase_admin
--

COMMENT ON FUNCTION extensions.grant_pg_graphql_access() IS 'Grants access to pg_graphql';


--
-- Name: grant_pg_net_access(); Type: FUNCTION; Schema: extensions; Owner: supabase_admin
--

CREATE FUNCTION extensions.grant_pg_net_access() RETURNS event_trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  IF EXISTS (
    SELECT 1
    FROM pg_event_trigger_ddl_commands() AS ev
    JOIN pg_extension AS ext
    ON ev.objid = ext.oid
    WHERE ext.extname = 'pg_net'
  )
  THEN
    IF NOT EXISTS (
      SELECT 1
      FROM pg_roles
      WHERE rolname = 'supabase_functions_admin'
    )
    THEN
      CREATE USER supabase_functions_admin NOINHERIT CREATEROLE LOGIN NOREPLICATION;
    END IF;

    GRANT USAGE ON SCHEMA net TO supabase_functions_admin, postgres, anon, authenticated, service_role;

    IF EXISTS (
      SELECT FROM pg_extension
      WHERE extname = 'pg_net'
      -- all versions in use on existing projects as of 2025-02-20
      -- version 0.12.0 onwards don't need these applied
      AND extversion IN ('0.2', '0.6', '0.7', '0.7.1', '0.8', '0.10.0', '0.11.0')
    ) THEN
      ALTER function net.http_get(url text, params jsonb, headers jsonb, timeout_milliseconds integer) SECURITY DEFINER;
      ALTER function net.http_post(url text, body jsonb, params jsonb, headers jsonb, timeout_milliseconds integer) SECURITY DEFINER;

      ALTER function net.http_get(url text, params jsonb, headers jsonb, timeout_milliseconds integer) SET search_path = net;
      ALTER function net.http_post(url text, body jsonb, params jsonb, headers jsonb, timeout_milliseconds integer) SET search_path = net;

      REVOKE ALL ON FUNCTION net.http_get(url text, params jsonb, headers jsonb, timeout_milliseconds integer) FROM PUBLIC;
      REVOKE ALL ON FUNCTION net.http_post(url text, body jsonb, params jsonb, headers jsonb, timeout_milliseconds integer) FROM PUBLIC;

      GRANT EXECUTE ON FUNCTION net.http_get(url text, params jsonb, headers jsonb, timeout_milliseconds integer) TO supabase_functions_admin, postgres, anon, authenticated, service_role;
      GRANT EXECUTE ON FUNCTION net.http_post(url text, body jsonb, params jsonb, headers jsonb, timeout_milliseconds integer) TO supabase_functions_admin, postgres, anon, authenticated, service_role;
    END IF;
  END IF;
END;
$$;


ALTER FUNCTION extensions.grant_pg_net_access() OWNER TO supabase_admin;

--
-- Name: FUNCTION grant_pg_net_access(); Type: COMMENT; Schema: extensions; Owner: supabase_admin
--

COMMENT ON FUNCTION extensions.grant_pg_net_access() IS 'Grants access to pg_net';


--
-- Name: pgrst_ddl_watch(); Type: FUNCTION; Schema: extensions; Owner: supabase_admin
--

CREATE FUNCTION extensions.pgrst_ddl_watch() RETURNS event_trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  cmd record;
BEGIN
  FOR cmd IN SELECT * FROM pg_event_trigger_ddl_commands()
  LOOP
    IF cmd.command_tag IN (
      'CREATE SCHEMA', 'ALTER SCHEMA'
    , 'CREATE TABLE', 'CREATE TABLE AS', 'SELECT INTO', 'ALTER TABLE'
    , 'CREATE FOREIGN TABLE', 'ALTER FOREIGN TABLE'
    , 'CREATE VIEW', 'ALTER VIEW'
    , 'CREATE MATERIALIZED VIEW', 'ALTER MATERIALIZED VIEW'
    , 'CREATE FUNCTION', 'ALTER FUNCTION'
    , 'CREATE TRIGGER'
    , 'CREATE TYPE', 'ALTER TYPE'
    , 'CREATE RULE'
    , 'COMMENT'
    )
    -- don't notify in case of CREATE TEMP table or other objects created on pg_temp
    AND cmd.schema_name is distinct from 'pg_temp'
    THEN
      NOTIFY pgrst, 'reload schema';
    END IF;
  END LOOP;
END; $$;


ALTER FUNCTION extensions.pgrst_ddl_watch() OWNER TO supabase_admin;

--
-- Name: pgrst_drop_watch(); Type: FUNCTION; Schema: extensions; Owner: supabase_admin
--

CREATE FUNCTION extensions.pgrst_drop_watch() RETURNS event_trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  obj record;
BEGIN
  FOR obj IN SELECT * FROM pg_event_trigger_dropped_objects()
  LOOP
    IF obj.object_type IN (
      'schema'
    , 'table'
    , 'foreign table'
    , 'view'
    , 'materialized view'
    , 'function'
    , 'trigger'
    , 'type'
    , 'rule'
    )
    AND obj.is_temporary IS false -- no pg_temp objects
    THEN
      NOTIFY pgrst, 'reload schema';
    END IF;
  END LOOP;
END; $$;


ALTER FUNCTION extensions.pgrst_drop_watch() OWNER TO supabase_admin;

--
-- Name: set_graphql_placeholder(); Type: FUNCTION; Schema: extensions; Owner: supabase_admin
--

CREATE FUNCTION extensions.set_graphql_placeholder() RETURNS event_trigger
    LANGUAGE plpgsql
    AS $_$
    DECLARE
    graphql_is_dropped bool;
    BEGIN
    graphql_is_dropped = (
        SELECT ev.schema_name = 'graphql_public'
        FROM pg_event_trigger_dropped_objects() AS ev
        WHERE ev.schema_name = 'graphql_public'
    );

    IF graphql_is_dropped
    THEN
        create or replace function graphql_public.graphql(
            "operationName" text default null,
            query text default null,
            variables jsonb default null,
            extensions jsonb default null
        )
            returns jsonb
            language plpgsql
        as $$
            DECLARE
                server_version float;
            BEGIN
                server_version = (SELECT (SPLIT_PART((select version()), ' ', 2))::float);

                IF server_version >= 14 THEN
                    RETURN jsonb_build_object(
                        'errors', jsonb_build_array(
                            jsonb_build_object(
                                'message', 'pg_graphql extension is not enabled.'
                            )
                        )
                    );
                ELSE
                    RETURN jsonb_build_object(
                        'errors', jsonb_build_array(
                            jsonb_build_object(
                                'message', 'pg_graphql is only available on projects running Postgres 14 onwards.'
                            )
                        )
                    );
                END IF;
            END;
        $$;
    END IF;

    END;
$_$;


ALTER FUNCTION extensions.set_graphql_placeholder() OWNER TO supabase_admin;

--
-- Name: FUNCTION set_graphql_placeholder(); Type: COMMENT; Schema: extensions; Owner: supabase_admin
--

COMMENT ON FUNCTION extensions.set_graphql_placeholder() IS 'Reintroduces placeholder function for graphql_public.graphql';


--
-- Name: get_auth(text); Type: FUNCTION; Schema: pgbouncer; Owner: supabase_admin
--

CREATE FUNCTION pgbouncer.get_auth(p_usename text) RETURNS TABLE(username text, password text)
    LANGUAGE plpgsql SECURITY DEFINER
    AS $_$
begin
    raise debug 'PgBouncer auth request: %', p_usename;

    return query
    select 
        rolname::text, 
        case when rolvaliduntil < now() 
            then null 
            else rolpassword::text 
        end 
    from pg_authid 
    where rolname=$1 and rolcanlogin;
end;
$_$;


ALTER FUNCTION pgbouncer.get_auth(p_usename text) OWNER TO supabase_admin;

--
-- Name: add_loan_payment(uuid, date, numeric, numeric, text, text, text, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.add_loan_payment(p_loan_id uuid, p_payment_date date, p_principal_amount numeric, p_interest_amount numeric DEFAULT 0, p_payment_method text DEFAULT 'Tunai'::text, p_bank_name text DEFAULT NULL::text, p_reference_number text DEFAULT NULL::text, p_notes text DEFAULT NULL::text) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_loan RECORD;
  v_payment JSONB;
  v_journal_ref TEXT;
BEGIN
  SELECT * INTO v_loan FROM loans WHERE id = p_loan_id;
  
  IF NOT FOUND THEN
    RAISE EXCEPTION 'Loan not found';
  END IF;
  
  v_journal_ref := 'LPAY-' || TO_CHAR(p_payment_date, 'YYYYMMDD') || '-' || LPAD(EXTRACT(EPOCH FROM NOW())::TEXT, 6, '0');
  
  v_payment := jsonb_build_object(
    'payment_date', p_payment_date,
    'principal_amount', p_principal_amount,
    'interest_amount', p_interest_amount,
    'total_payment', p_principal_amount + p_interest_amount,
    'payment_method', p_payment_method,
    'bank_name', p_bank_name,
    'reference_number', p_reference_number,
    'notes', p_notes,
    'journal_ref', v_journal_ref,
    'timestamp', NOW()
  );
  
  UPDATE loans
  SET 
    total_paid = COALESCE(total_paid, 0) + p_principal_amount,
    total_interest_paid = COALESCE(total_interest_paid, 0) + p_interest_amount,
    payment_history = COALESCE(payment_history, '[]'::jsonb) || v_payment,
    updated_at = NOW()
  WHERE id = p_loan_id;
  
  INSERT INTO journal_entries (
    journal_ref,
    debit_account,
    credit_account,
    debit,
    credit,
    description,
    tanggal,
    jenis_transaksi
  ) VALUES (
    v_journal_ref,
    v_loan.coa_loan_code,
    v_loan.coa_cash_code,
    p_principal_amount,
    p_principal_amount,
    'Pembayaran Pinjaman - ' || v_loan.lender_name,
    p_payment_date,
    'Pembayaran Pinjaman'
  );
  
  IF p_interest_amount > 0 THEN
    INSERT INTO journal_entries (
      journal_ref,
      debit_account,
      credit_account,
      debit,
      credit,
      description,
      tanggal,
      jenis_transaksi
    ) VALUES (
      v_journal_ref,
      v_loan.coa_interest_code,
      v_loan.coa_cash_code,
      p_interest_amount,
      p_interest_amount,
      'Bunga Pinjaman - ' || v_loan.lender_name,
      p_payment_date,
      'Pembayaran Pinjaman'
    );
  END IF;
  
  RETURN v_payment;
END;
$$;


ALTER FUNCTION public.add_loan_payment(p_loan_id uuid, p_payment_date date, p_principal_amount numeric, p_interest_amount numeric, p_payment_method text, p_bank_name text, p_reference_number text, p_notes text) OWNER TO postgres;

--
-- Name: add_to_gl(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.add_to_gl() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    acc_name TEXT;
BEGIN
    -- ambil nama akun dari COA
    SELECT account_name INTO acc_name
    FROM chart_of_accounts
    WHERE account_code = NEW.account_code
    LIMIT 1;

    INSERT INTO general_ledger (
        journal_entry_id,
        account_code,
        account_name,
        debit,
        credit,
        date,
        description
    )
    VALUES (
        NEW.id,
        NEW.account_code,
        acc_name,
        NEW.debit,
        NEW.credit,
        NEW.transaction_date,
        NEW.description
    );

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.add_to_gl() OWNER TO postgres;

--
-- Name: ai_cancel_booking(uuid, uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.ai_cancel_booking(p_booking_id uuid, p_user_id uuid) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
begin
  update bookings set status='cancelled' where id = p_booking_id and user_id = p_user_id;
  if found then
    return true;
  else
    return false;
  end if;
end;
$$;


ALTER FUNCTION public.ai_cancel_booking(p_booking_id uuid, p_user_id uuid) OWNER TO postgres;

--
-- Name: ai_create_booking(uuid, uuid, timestamp with time zone, timestamp with time zone, numeric, jsonb); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.ai_create_booking(p_user_id uuid, p_facility_id uuid, p_start timestamp with time zone, p_end timestamp with time zone, p_price numeric, p_metadata jsonb DEFAULT '{}'::jsonb) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
declare
  new_id uuid;
  avail boolean;
begin
  select check_availability(p_facility_id, p_start, p_end) into avail;
  if not avail then
    raise exception 'slot_not_available';
  end if;

  insert into bookings(user_id, facility_id, start_time, end_time, duration_minutes, price, status, metadata)
  values (p_user_id, p_facility_id, p_start, p_end, extract(epoch from (p_end - p_start))/60, p_price, 'confirmed', p_metadata)
  returning id into new_id;

  return new_id;
end;
$$;


ALTER FUNCTION public.ai_create_booking(p_user_id uuid, p_facility_id uuid, p_start timestamp with time zone, p_end timestamp with time zone, p_price numeric, p_metadata jsonb) OWNER TO postgres;

--
-- Name: ai_safe_sql_exec(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.ai_safe_sql_exec(sql_text text) RETURNS SETOF record
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  IF lower(trim(sql_text)) NOT LIKE 'select%' THEN
    RAISE EXCEPTION 'Only SELECT allowed';
  END IF;

  IF sql_text ~* '(insert|update|delete|drop|alter|truncate|grant|revoke|create)' THEN
    RAISE EXCEPTION 'Forbidden keyword';
  END IF;

  RETURN QUERY EXECUTE sql_text;
END;
$$;


ALTER FUNCTION public.ai_safe_sql_exec(sql_text text) OWNER TO postgres;

--
-- Name: ai_update_booking_time(uuid, uuid, timestamp with time zone, timestamp with time zone); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.ai_update_booking_time(p_booking_id uuid, p_user_id uuid, p_start timestamp with time zone, p_end timestamp with time zone) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
declare
  f_id uuid;
  avail boolean;
begin
  select facility_id into f_id from bookings where id = p_booking_id and user_id = p_user_id and status!='cancelled';
  if not found then
    return false;
  end if;
  select check_availability(f_id, p_start, p_end) into avail;
  if not avail then
    raise exception 'slot_not_available';
  end if;
  update bookings set start_time = p_start, end_time = p_end, duration_minutes = extract(epoch from (p_end - p_start))/60 where id = p_booking_id;
  return true;
end;
$$;


ALTER FUNCTION public.ai_update_booking_time(p_booking_id uuid, p_user_id uuid, p_start timestamp with time zone, p_end timestamp with time zone) OWNER TO postgres;

--
-- Name: apply_ai_mapping(uuid, boolean); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.apply_ai_mapping(p_id uuid, p_auto_post boolean DEFAULT false) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
declare
  bs record;
  smart jsonb;
  ai_resp jsonb;
  ai_text text;
  ai_coa text;
  fallback_coa text;
  ai_conf int := 0;
  pipeline jsonb := '{}'::jsonb;
  mapped jsonb;
begin
  ---------------------------------------------------------------------
  -- 0. Ambil data bank statement
  ---------------------------------------------------------------------
  select * into bs from bank_statements where id = p_id;
  if not found then
    raise exception '[AI-MAP] bank_statement % tidak ditemukan', p_id;
  end if;

  ---------------------------------------------------------------------
  -- 1. Jika sudah pernah dimapping → return saja
  ---------------------------------------------------------------------
  if bs.mapped_coa_debit is not null or bs.mapped_coa_credit is not null then
    return jsonb_build_object(
      'status','already_mapped',
      'mapping_result', bs.mapping_result
    );
  end if;

  ---------------------------------------------------------------------
  -- 2. SMART RULE ENGINE (priority #1)
  ---------------------------------------------------------------------
  smart := smart_find_rule(p_id);

  if smart is not null 
     and (smart->>'coa') is not null 
     and (smart->>'coa') <> '' 
  then
     ai_coa := smart->>'coa';
     ai_conf := coalesce((smart->>'score')::int, 0);

     pipeline := pipeline || jsonb_build_object(
       'smart', smart,
       'smart_used', true
     );
  else
     pipeline := pipeline || jsonb_build_object('smart_used', false);
  end if;

  ---------------------------------------------------------------------
  -- 3. AI LLM ENGINE (hanya dipakai jika smart rule tidak dapat COA)
  ---------------------------------------------------------------------
  if ai_coa is null or ai_coa = '' then
    begin
      select (net.http_post(
        'https://<YOUR_EDGE_FUNCTION_URL>/ai-map-mutasi',
        jsonb_build_object(
          'description', coalesce(bs.description,''),
          'debit', coalesce(bs.debit,0),
          'credit', coalesce(bs.credit,0),
          'account_code', coalesce(bs.account_code,'')
        )::text,
        jsonb_build_object('timeout', 12000)::text
      )).content into ai_text;
    exception when others then
      ai_text := null;
    end;

    if ai_text is not null then
      begin
        ai_resp := ai_text::jsonb;
        ai_coa  := ai_resp->>'coa_account_code';
        ai_conf := coalesce((ai_resp->>'confidence')::int, 0);

        pipeline := pipeline || jsonb_build_object(
          'ai_response', ai_resp,
          'ai_used', true
        );
      exception
        when others then
          pipeline := pipeline || jsonb_build_object(
            'ai_used', false,
            'ai_raw', ai_text
          );
      end;
    end if;
  end if;

  ---------------------------------------------------------------------
  -- 4. COA EMBEDDING ENGINE (PRO) → dipakai jika AI & smart gagal
  ---------------------------------------------------------------------
  if ai_coa is null or ai_coa = '' then
    begin
      select embedding_coa_match(coalesce(bs.description,'')) 
      into ai_resp;

      if ai_resp is not null then
        ai_coa := ai_resp->>'account_code';

        pipeline := pipeline || jsonb_build_object(
          'embedding_used', true,
          'embedding_result', ai_resp
        );
      end if;
    exception when others then
      pipeline := pipeline || jsonb_build_object(
        'embedding_used', false,
        'embedding_error', sqlerrm
      );
    end;
  end if;

  ---------------------------------------------------------------------
  -- 5. FALLBACK KATEGORI (langkah terakhir)
  ---------------------------------------------------------------------
  if ai_coa is null or ai_coa = '' then
    fallback_coa := get_default_coa_for_category(
      coalesce((smart->>'kategori'), 'Operasional')
    );

    if fallback_coa is not null then
      ai_coa := fallback_coa;

      pipeline := pipeline || jsonb_build_object(
        'fallback_used', true,
        'fallback_coa', fallback_coa
      );
    else
      update bank_statements
      set mapping_result = jsonb_build_object(
        'status','unmatched',
        'pipeline', pipeline
      ),
      updated_at = now()
      where id = p_id;

      return jsonb_build_object(
        'status','unmatched',
        'reason','no-coa-found'
      );
    end if;
  end if;

  ---------------------------------------------------------------------
  -- 6. VALIDASI COA ADA DI CHART OF ACCOUNTS
  ---------------------------------------------------------------------
  begin
    perform 1 from chart_of_accounts where account_code = ai_coa;
    if not found then
      pipeline := pipeline || jsonb_build_object(
        'invalid_coa', ai_coa
      );
      return jsonb_build_object('status','invalid_coa','coa', ai_coa);
    end if;
  exception when others then
    -- ignore
  end;

  ---------------------------------------------------------------------
  -- 7. BANGUN MAPPING (pengeluaran / pendapatan)
  ---------------------------------------------------------------------
  if coalesce(bs.credit,0) > coalesce(bs.debit,0) then
    mapped := jsonb_build_object(
      'mapped_table','pendapatan',
      'mapped_coa_credit', ai_coa,
      'mapped_coa_debit', coalesce(bs.account_code,'')
    );
  else
    mapped := jsonb_build_object(
      'mapped_table','pengeluaran',
      'mapped_coa_debit', ai_coa,
      'mapped_coa_credit', coalesce(bs.account_code,'')
    );
  end if;

  ---------------------------------------------------------------------
  -- 8. SIMPAN HASIL MAPPING
  ---------------------------------------------------------------------
  update bank_statements
  set mapped_table     = mapped->>'mapped_table',
      mapped_coa_debit = mapped->>'mapped_coa_debit',
      mapped_coa_credit= mapped->>'mapped_coa_credit',
      mapping_result   = jsonb_build_object(
        'pipeline', pipeline,
        'final', mapped,
        'confidence', ai_conf
      ),
      status='matched',
      updated_at = now()
  where id = p_id;

  ---------------------------------------------------------------------
  -- 9. AUTO RULE CREATION (hanya kalau AI confidence ≥ 85)
  ---------------------------------------------------------------------
  if ai_conf >= 85 then
    begin
      insert into bank_mutasi_mapping (
        keyword, dk, pos, kategori, akun,
        coa_account_code, sub_akun, pic, priority, is_active
      )
      values (
        lower(coalesce(
          pipeline->'ai_response'->>'keyword',
          pipeline->'smart'->>'keyword',
          bs.description
        )),
        case when coalesce(bs.credit,0) > coalesce(bs.debit,0) then 'K' else 'D' end,
        pipeline->'smart'->>'pos',
        pipeline->'smart'->>'kategori',
        'Auto - ' || (pipeline->'smart'->>'kategori'),
        ai_coa,
        null,
        'System',
        5,
        true
      )
      on conflict (keyword) do update set
        coa_account_code = excluded.coa_account_code,
        is_active = true;

      pipeline := pipeline || jsonb_build_object('auto_rule_created', true);
    exception when others then
      pipeline := pipeline || jsonb_build_object('auto_rule_created', false,'error',sqlerrm);
    end;
  end if;

  ---------------------------------------------------------------------
  -- 10. AUTO POST JURNAL (optional, p_auto_post = true)
  ---------------------------------------------------------------------
  if p_auto_post then
    begin
      perform post_bank_statement_as_journal(p_id, null);
      pipeline := pipeline || jsonb_build_object('auto_post', true);
    exception when others then
      pipeline := pipeline || jsonb_build_object('auto_post', false,'error',sqlerrm);
    end;
  end if;

  ---------------------------------------------------------------------
  -- RETURN
  ---------------------------------------------------------------------
  return jsonb_build_object(
    'status','matched',
    'final', mapped,
    'confidence', ai_conf,
    'pipeline', pipeline
  );
end;
$$;


ALTER FUNCTION public.apply_ai_mapping(p_id uuid, p_auto_post boolean) OWNER TO postgres;

--
-- Name: apply_coa_mapping_to_disbursement(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.apply_coa_mapping_to_disbursement(p_disbursement_id uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_category TEXT;
    v_account_code TEXT;
    v_account_name TEXT;
BEGIN
    SELECT category INTO v_category
    FROM public.cash_disbursement
    WHERE id = p_disbursement_id;

    IF v_category IS NULL THEN
        RAISE EXCEPTION 'Category is missing for cash_disbursement %', p_disbursement_id;
    END IF;

    SELECT account_code, account_name
    INTO v_account_code, v_account_name
    FROM public.coa_mapping
    WHERE UPPER(category) = UPPER(v_category)
    LIMIT 1;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'COA mapping not found for category %', v_category;
    END IF;

    UPDATE public.cash_disbursement
    SET account_code = v_account_code,
        account_name = v_account_name
    WHERE id = p_disbursement_id;
END;
$$;


ALTER FUNCTION public.apply_coa_mapping_to_disbursement(p_disbursement_id uuid) OWNER TO postgres;

--
-- Name: apply_tax_engine(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.apply_tax_engine(p_id uuid) RETURNS jsonb
    LANGUAGE plpgsql
    AS $$
declare
  bs record;
  rule record;
  kw text;
  base_amount numeric;
  tax_amount numeric;
  result jsonb;
begin
  select * into bs from bank_statements where id = p_id;

  if bs.is_taxable = false then
    result := jsonb_build_object('pajak','none');
    update bank_statements set tax_result = result where id = p_id;
    return result;
  end if;

  kw := lower(bs.description);

  for rule in 
    select * from tax_rules order by priority asc
  loop
    if position(lower(rule.keyword) in kw) > 0 then

      if rule.pajak = 'ppn' then
        base_amount := round(bs.debit / (1 + (rule.tarif/100)), 2);
        tax_amount := round(bs.debit - base_amount, 2);

      elsif rule.pajak in ('pph23','pph21') then
        tax_amount := round(bs.debit * rule.tarif / 100, 2);
        base_amount := bs.debit - tax_amount;

      else
        base_amount := bs.debit;
        tax_amount := 0;
      end if;

      result := jsonb_build_object(
        'pajak',rule.pajak,
        'tarif',rule.tarif,
        'base_amount',base_amount,
        'tax_amount',tax_amount,
        'akun_pajak',rule.akun_pajak,
        'akun_dasar',rule.akun_dasar
      );

      update bank_statements set tax_result=result where id=p_id;
      return result;
    end if;
  end loop;

  result := jsonb_build_object('pajak','none');
  update bank_statements set tax_result=result where id=p_id;
  return result;
end;
$$;


ALTER FUNCTION public.apply_tax_engine(p_id uuid) OWNER TO postgres;

--
-- Name: assert_physical_item(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.assert_physical_item() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
begin
  if (select type from items where id = new.item_id) <> 'physical' then
    raise exception 'Item % bukan physical', new.item_id;
  end if;
  return new;
end$$;


