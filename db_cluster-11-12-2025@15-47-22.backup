--
-- Name: get_balance_sheet(date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_balance_sheet(p_as_of_date date) RETURNS TABLE(section text, account_code text, account_name text, amount numeric)
    LANGUAGE sql
    AS $$
    WITH bs AS (
        SELECT 
            jel.account_code,
            MIN(jel.account_name) AS account_name,
            SUM(jel.debit - jel.credit) AS amount
        FROM public.journal_entry_lines jel
        JOIN public.journal_entries je ON jel.journal_id = je.id
        WHERE je.journal_date <= p_as_of_date
        GROUP BY jel.account_code
    )
    SELECT 
        CASE 
            WHEN account_code LIKE '1%' THEN 'Aset'
            WHEN account_code LIKE '2%' THEN 'Kewajiban'
            WHEN account_code LIKE '3%' THEN 'Ekuitas'
            ELSE 'Lainnya'
        END AS section,
        account_code,
        account_name,
        amount
    FROM bs
    WHERE account_code LIKE ANY (ARRAY['1%', '2%', '3%'])
    ORDER BY section, account_code;
$$;


ALTER FUNCTION public.get_balance_sheet(p_as_of_date date) OWNER TO postgres;

