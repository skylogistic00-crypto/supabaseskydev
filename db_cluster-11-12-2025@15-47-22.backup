--
-- Data for Name: schema_migrations; Type: TABLE DATA; Schema: supabase_migrations; Owner: postgres
--

COPY supabase_migrations.schema_migrations (version, statements, name) FROM stdin;
20251129	{"CREATE TABLE IF NOT EXISTS public.account_mappings (\r\n    id BIGSERIAL PRIMARY KEY,\r\n    category TEXT NOT NULL,\r\n    debit_account VARCHAR(20),\r\n    credit_account VARCHAR(20),\r\n    created_at TIMESTAMPTZ DEFAULT NOW(),\r\n    updated_at TIMESTAMPTZ DEFAULT NOW()\r\n)","CREATE TABLE IF NOT EXISTS public.journal_entries (\r\n    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\r\n    journal_number TEXT UNIQUE,\r\n    description TEXT,\r\n    reference_id UUID,\r\n    posted_at TIMESTAMPTZ DEFAULT NOW(),\r\n    created_at TIMESTAMPTZ DEFAULT NOW()\r\n)","CREATE TABLE IF NOT EXISTS public.journal_entry_lines (\r\n    id BIGSERIAL PRIMARY KEY,\r\n    journal_id UUID REFERENCES journal_entries(id) ON DELETE CASCADE,\r\n    account_code VARCHAR(20) NOT NULL,\r\n    debit NUMERIC(18,2) DEFAULT 0,\r\n    credit NUMERIC(18,2) DEFAULT 0,\r\n    created_at TIMESTAMPTZ DEFAULT NOW()\r\n)","CREATE OR REPLACE FUNCTION generate_journal_number()\r\nRETURNS TEXT AS $$\r\nDECLARE\r\n    num TEXT;\r\nBEGIN\r\n    num := 'J-' || TO_CHAR(NOW(), 'YYYYMMDDHH24MISS');\r\n    RETURN num;\r\nEND;\r\n$$ LANGUAGE plpgsql","CREATE OR REPLACE FUNCTION post_cash_disbursement(disbursement_id UUID)\r\nRETURNS UUID AS $$\r\nDECLARE\r\n    disb RECORD;\r\n    map RECORD;\r\n    jid UUID;\r\nBEGIN\r\n    SELECT * INTO disb FROM cash_disbursement WHERE id = disbursement_id;\r\n    IF NOT FOUND THEN\r\n        RAISE EXCEPTION 'Cash Disbursement not found';\r\n    END IF;\r\n\r\n    SELECT * INTO map FROM account_mappings WHERE category = disb.category;\r\n    IF NOT FOUND THEN\r\n        RAISE EXCEPTION 'Account mapping not found for category %', disb.category;\r\n    END IF;\r\n\r\n    INSERT INTO journal_entries (journal_number, description, reference_id)\r\n    VALUES (generate_journal_number(), disb.description, disbursement_id)\r\n    RETURNING id INTO jid;\r\n\r\n    INSERT INTO journal_entry_lines (journal_id, account_code, debit, credit)\r\n    VALUES (jid, map.debit_account, disb.amount, 0);\r\n\r\n    INSERT INTO journal_entry_lines (journal_id, account_code, debit, credit)\r\n    VALUES (jid, map.credit_account, 0, disb.amount);\r\n\r\n    UPDATE cash_disbursement\r\n    SET journal_id = jid, status = 'posted'\r\n    WHERE id = disbursement_id;\r\n\r\n    RETURN jid;\r\nEND;\r\n$$ LANGUAGE plpgsql","CREATE OR REPLACE FUNCTION reverse_journal(journal_id UUID)\r\nRETURNS VOID AS $$\r\nBEGIN\r\n    INSERT INTO journal_entry_lines (journal_id, account_code, debit, credit)\r\n    SELECT journal_id, account_code, credit, debit\r\n    FROM journal_entry_lines\r\n    WHERE journal_id = reverse_journal.journal_id;\r\nEND;\r\n$$ LANGUAGE plpgsql","CREATE OR REPLACE FUNCTION generate_trial_balance()\r\nRETURNS TABLE (\r\n    account_code TEXT,\r\n    total_debit NUMERIC,\r\n    total_credit NUMERIC\r\n) AS $$\r\nBEGIN\r\n    RETURN QUERY\r\n    SELECT account_code,\r\n           SUM(debit) AS total_debit,\r\n           SUM(credit) AS total_credit\r\n    FROM journal_entry_lines\r\n    GROUP BY account_code\r\n    ORDER BY account_code;\r\nEND;\r\n$$ LANGUAGE plpgsql","CREATE OR REPLACE FUNCTION generate_laba_rugi()\r\nRETURNS TABLE (\r\n    type TEXT,\r\n    amount NUMERIC\r\n) AS $$\r\nBEGIN\r\n    RETURN QUERY\r\n    SELECT 'Pendapatan', SUM(credit - debit)\r\n    FROM journal_entry_lines\r\n    WHERE account_code LIKE '4%';\r\n\r\n    RETURN QUERY\r\n    SELECT 'Biaya', SUM(debit - credit)\r\n    FROM journal_entry_lines\r\n    WHERE account_code LIKE '5%';\r\nEND;\r\n$$ LANGUAGE plpgsql","CREATE OR REPLACE FUNCTION generate_neraca()\r\nRETURNS TABLE (\r\n    type TEXT,\r\n    amount NUMERIC\r\n) AS $$\r\nBEGIN\r\n    RETURN QUERY SELECT 'Aset', SUM(debit - credit)\r\n    FROM journal_entry_lines\r\n    WHERE account_code LIKE '1%';\r\n\r\n    RETURN QUERY SELECT 'Liabilitas', SUM(credit - debit)\r\n    FROM journal_entry_lines\r\n    WHERE account_code LIKE '2%';\r\n\r\n    RETURN QUERY SELECT 'Ekuitas', SUM(credit - debit)\r\n    FROM journal_entry_lines\r\n    WHERE account_code LIKE '3%';\r\nEND;\r\n$$ LANGUAGE plpgsql"}	accounting
\.


