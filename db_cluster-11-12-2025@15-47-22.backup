BEGIN
  -- Jika role_id berubah, ambil role_name dari tabel roles
  IF NEW.role_id IS NOT NULL THEN
    SELECT role_name INTO new_role_name
    FROM public.roles
    WHERE role_id = NEW.role_id;

    -- update kolom utama public.users
    NEW.role_name := new_role_name;
    NEW.role := new_role_name;
  END IF;

  RETURN NEW;
END;
$$;


