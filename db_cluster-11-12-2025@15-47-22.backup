--
-- Name: auto_map_coa(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.auto_map_coa() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_code TEXT;
    v_name TEXT;
BEGIN
    IF NEW.category IS NULL THEN
        RETURN NEW; -- nothing to map
    END IF;

    SELECT account_code, account_name
    INTO v_code, v_name
    FROM public.coa_mapping
    WHERE UPPER(category) = UPPER(NEW.category)
    LIMIT 1;

    IF FOUND THEN
        NEW.account_code := v_code;
        NEW.account_name := v_name;
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.auto_map_coa() OWNER TO postgres;

--
-- Name: auto_map_coa_fields(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.auto_map_coa_fields() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- ===== trans_type =====
    IF NEW.trans_type IS NULL THEN
        NEW.trans_type := CASE
            WHEN NEW.account_type ILIKE 'Aset' THEN 'asset'
            WHEN NEW.account_type ILIKE 'Kewajiban' THEN 'liability'
            WHEN NEW.account_type ILIKE 'Ekuitas' THEN 'equity'
            WHEN NEW.account_type ILIKE 'Pendapatan' THEN 'revenue'
            WHEN NEW.account_type ILIKE 'Beban Pokok Penjualan' THEN 'cogs'
            WHEN NEW.account_type ILIKE 'Beban Operasional' THEN 'expense'
            WHEN NEW.account_type ILIKE 'Pendapatan & Beban Lain-lain' THEN 'other'
            ELSE 'other'
        END;
    END IF;

    -- ===== flow_type =====
    IF NEW.flow_type IS NULL THEN
        NEW.flow_type := CASE
            WHEN NEW.account_name ILIKE '%kas%' OR NEW.account_name ILIKE '%bank%' THEN 'cash'
            WHEN NEW.account_type ILIKE 'Pendapatan%' THEN 'revenue'
            WHEN NEW.account_type ILIKE 'Beban%' THEN 'expense'
            WHEN NEW.account_type ILIKE 'Kewajiban%' THEN 'non_cash'
            WHEN NEW.account_type ILIKE 'Ekuitas%' THEN 'non_cash'
            ELSE 'non_cash'
        END;
    END IF;

    -- ===== usage_role =====
    IF NEW.usage_role IS NULL THEN
        NEW.usage_role := CASE
            WHEN NEW.account_name ILIKE '%kas%' OR NEW.account_name ILIKE '%bank%' THEN 'kas'
            WHEN NEW.account_name ILIKE '%piutang%' THEN 'piutang'
            WHEN NEW.account_name ILIKE '%hutang%' THEN 'hutang'
            WHEN NEW.account_name ILIKE '%persediaan%' THEN 'inventory'
            WHEN NEW.account_name ILIKE '%pendapatan%' AND NEW.account_name ILIKE '%jasa%' THEN 'pendapatan_jasa'
            WHEN NEW.account_name ILIKE '%pendapatan%' AND NEW.account_name ILIKE '%barang%' THEN 'pendapatan_barang'
            WHEN NEW.account_name ILIKE '%hpp%' OR NEW.account_type ILIKE 'Beban Pokok Penjualan' THEN 'hpp'
            WHEN NEW.account_name ILIKE '%beban%' AND NEW.account_name ILIKE '%kendaraan%' THEN 'beban_kendaraan'
            WHEN NEW.account_name ILIKE '%beban%' AND NEW.account_name ILIKE '%operasional%' THEN 'beban_operasional'
            WHEN NEW.account_name ILIKE '%beban%' AND NEW.account_name ILIKE '%warehouse%' THEN 'beban_warehouse'
            WHEN NEW.account_name ILIKE '%beban%' THEN 'beban_lain'
            ELSE 'general'
        END;
    END IF;

    RETURN NEW;
END;
$$;


ALTER FUNCTION public.auto_map_coa_fields() OWNER TO postgres;

